---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Search from 'astro-pagefind/components/Search';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { withBase } from '../../lib/path';
import { CATEGORIES, categoryMeta } from '../../lib/nav';

const entries = await getCollection('wiki', ({ data }) => data.draft !== true);

const groups = CATEGORIES.map((cat) => ({
  ...cat,
  items: entries
    .filter((e) => e.data.category === cat.id)
    .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'ja')),
})).filter((g) => g.items.length > 0);

const known = new Set(CATEGORIES.map((c) => c.id));
for (const e of entries.filter((e) => !known.has(e.data.category))) {
  let g = groups.find((g) => g.id === e.data.category);
  if (!g) {
    g = { ...categoryMeta(e.data.category), items: [] };
    groups.push(g);
  }
  g.items.push(e);
}
---

<BaseLayout title="wiki">
  <div class="layout has-sidebar">
    <Sidebar />
    <div class="content">
      <section class="page-head">
        <p class="eyebrow">wiki</p>
        <h1>NTE なんでもwiki</h1>
        <p class="lead">NTEに関する攻略・データ・覚え書き。カテゴリから探すか、検索してください。</p>
      </section>

      <div class="card card-pad" style="margin-bottom:32px;">
        <Search id="search" className="pagefind-ui" uiOptions={{ showImages: false, excerptLength: 15 }} />
      </div>

      {
        groups.map((group) => (
          <section id={`cat-${group.id}`} style="margin-bottom:40px;scroll-margin-top:72px;">
            <div class="row" style="gap:8px;margin-bottom:14px;">
              <Icon name={`lucide:${group.icon}`} style="width:20px;height:20px;color:var(--accent);" />
              <h2 style="margin:0;">{group.label}</h2>
              <span class="badge">{group.items.length}</span>
            </div>
            <div class="grid grid-cards">
              {group.items.map((item) => (
                <a class="card card-pad card-link" href={withBase(`/wiki/${item.id}/`)}>
                  <div class="row row-between" style="align-items:flex-start;gap:8px;">
                    <span style="font-weight:700;">{item.data.title}</span>
                    <StatusBadge status={item.data.status} />
                  </div>
                  {item.data.description && (
                    <p class="muted text-sm" style="margin-top:6px;">{item.data.description}</p>
                  )}
                  {item.data.tags.length > 0 && (
                    <div class="cluster" style="margin-top:10px;">
                      {item.data.tags.slice(0, 4).map((t) => (
                        <span class="badge">#{t}</span>
                      ))}
                    </div>
                  )}
                </a>
              ))}
            </div>
          </section>
        ))
      }

      {
        groups.length === 0 && (
          <div class="empty">
            <Icon name="lucide:file-question" />
            <p>記事がまだありません。</p>
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>
