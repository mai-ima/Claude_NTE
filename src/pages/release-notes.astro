---
/**
 * 更新履歴（リリースノート）。
 *
 * ★ 2つの版を持つ（利用者の指示 2026-09-13）
 *   - **簡略版**（`summary`）… 既定で見える。1文で、何が変わったかだけ
 *   - **詳細版**（`detail`）… 切り替えると出る
 *
 * ★ 切り替えは**バージョン単位**（利用者の指示 2026-09-14）
 *   > バージョン詳細と簡潔の切り替えはそのバージョンの1項目ずつではなく1バージョンずつにして
 *
 *   前は項目ごとに「詳しく」が付いていて、詳しく読みたいときに**何回も押す**必要があった。
 *   いまは版の先頭のボタン1つで、その版の全項目がまとめて入れ替わる。
 *
 * ★ JavaScript を使わない
 *   隠したチェックボックスと `label` で切り替える（`:checked ~ …` で CSS だけで動く）。
 *   JS が動かない端末でも、**押せば切り替わる**。
 *
 * ★ 古いバージョンは畳んである（最新だけ開く）。全部を開いたままだと長すぎるため。
 *
 * 文中の `**強調**` は `boldToHtml` で太字にする（→ src/lib/inline-md.ts）。
 * Markdown を通していない場所なので、ここで変換しないと `**` が画面に出る。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { RELEASE_NOTES, changeOf } from '../data/releaseNotes';
import { boldToHtml } from '../lib/inline-md';
---

<BaseLayout title="更新履歴">
  <div class="layout">
    <div class="content" style="width:100%;max-width:760px;margin:0 auto;">
      <section class="page-head">
        <p class="eyebrow">更新履歴</p>
        <h1>リリースノート</h1>
        <p class="lead">
          このサイトの変更履歴です。はじめは要点だけを出しています。
          バージョンごとの「詳しく読む」を押すと、その版の説明がまとめて詳しくなります。
        </p>
      </section>

      <div class="stack" style="gap:14px;">
        {
          RELEASE_NOTES.map((note, i) => {
            const items = note.changes.map(changeOf);
            /* 詳しい説明を持つ項目が1つも無い版では、切り替えを出さない（押しても変わらないため） */
            const hasDetail = items.some((c) => c.detail);
            const toggleId = `rn-detail-${i}`;
            return (
              <details class="card release-note" open={i === 0}>
                <summary class="release-head">
                  <span class="badge badge-accent">{note.version}</span>
                  <strong class="release-title">{note.title}</strong>
                  <span class="muted text-sm release-date">{note.date}</span>
                  <Icon name="lucide:chevron-down" class="release-chevron" />
                </summary>

                <div class="release-body">
                  {hasDetail && (
                    <>
                      {/* 見た目には出さない。`label` を押すとここが切り替わる */}
                      <input type="checkbox" id={toggleId} class="release-toggle" />
                      <label class="release-switch" for={toggleId}>
                        <span class="release-switch-on">
                          <Icon name="lucide:list-tree" />
                          このバージョンを詳しく読む
                        </span>
                        <span class="release-switch-off">
                          <Icon name="lucide:list" />
                          要点だけに戻す
                        </span>
                      </label>
                    </>
                  )}

                  <ul class="release-list">
                    {items.map((c) => (
                      <li>
                        <span class="release-brief" set:html={boldToHtml(c.summary)} />
                        {/* 詳しい説明は**要点の下に足す**（入れ替えない）。
                            入れ替えてしまうと「何の話か」が分からないまま説明だけが残る。
                            詳しい説明が無い項目は、要点だけがそのまま残る。 */}
                        {c.detail && <span class="release-full" set:html={boldToHtml(c.detail)} />}
                      </li>
                    ))}
                  </ul>
                </div>
              </details>
            );
          })
        }
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* 変更履歴の文中に含まれる長い英字トークン（例: article:modified_time）が
     スマホ幅をはみ出さないよう、語中での折り返しを許可する。 */
  .content :is(li, strong, p, span) {
    overflow-wrap: anywhere;
  }

  .release-note {
    padding: 0;
  }
  /* 版の見出し。押すと開閉する。既定の三角は消して自前のシェブロンを出す */
  .release-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 8px;
    padding: 14px 16px;
    cursor: pointer;
    list-style: none;
  }
  .release-head::-webkit-details-marker {
    display: none;
  }
  /* 狭い画面では、版・日付・シェブロンを1行目に、題を2行目に送る。
     3つを横に並べると題が縦に潰れて読めなくなる（実測 393px）。 */
  .release-title {
    flex: 1 1 100%;
    order: 3;
    min-width: 0;
  }
  .release-date {
    flex: none;
    margin-left: auto;
  }
  @media (min-width: 560px) {
    /* 広い画面なら1行に収まる */
    .release-title {
      flex: 1 1 auto;
      order: 0;
    }
    .release-date {
      margin-left: 0;
    }
  }
  .release-chevron {
    flex: none;
    width: 18px;
    height: 18px;
    color: var(--text-muted);
    transition: transform 0.18s ease;
  }
  .release-note[open] .release-chevron {
    transform: rotate(180deg);
  }

  .release-body {
    padding: 0 16px 16px;
  }
  .release-list {
    margin: 0;
    padding-left: 1.3em;
  }
  .release-list > li {
    margin-bottom: 10px;
  }

  /* ---- 要点 ↔ 詳しく の切り替え（バージョン単位）------------------------
     JavaScript を使わない。隠したチェックボックスの状態を CSS が読む。
     `label` は `for` で結ばれているので、キーボードでも操作できる。 */
  .release-toggle {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .release-switch {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0 0 12px;
    padding: 5px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
  }
  .release-switch:hover {
    border-color: var(--accent);
  }
  /* キーボードで選んだときに、どこにいるか分かるようにする */
  .release-toggle:focus-visible + .release-switch {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .release-switch :global(svg) {
    width: 15px;
    height: 15px;
  }
  /* 既定は「要点」。押すと入れ替わる */
  .release-switch-off,
  .release-full {
    display: none;
  }
  .release-switch-on {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .release-toggle:checked + .release-switch .release-switch-on {
    display: none;
  }
  .release-toggle:checked + .release-switch .release-switch-off {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  /* 詳しく出すときは、要点を**見出しのように太く**して、その下に説明を足す */
  .release-toggle:checked ~ .release-list .release-brief {
    display: block;
    font-weight: 700;
  }
  .release-toggle:checked ~ .release-list .release-full {
    display: block;
    margin-top: 4px;
    padding-left: 10px;
    border-left: 3px solid var(--border);
    color: var(--text-muted);
    font-size: 0.92rem;
  }
  /* 詳しく出しているときは、行の間を少し空けて読みやすくする */
  .release-toggle:checked ~ .release-list > li {
    margin-bottom: 14px;
  }

  @media (prefers-reduced-motion: reduce) {
    .release-chevron {
      transition: none;
    }
  }
</style>
