---
/** 原神 攻略wiki のトップ（準備中）。
 *  読者向けの案内だけを書く（運営の事情や制作の過程は書かない）。 */
import { Icon } from 'astro-icon/components';
import GenshinLayout from '../../layouts/GenshinLayout.astro';
import { withBase } from '../../lib/path';
import { wiki } from '../../lib/wikis';

const w = wiki('genshin');
---

<GenshinLayout>
  <article class="gs-card">
    <p class="gs-eyebrow">Genshin Impact</p>
    <h1 class="gs-title">原神 攻略wiki</h1>
    <p class="gs-rule" aria-hidden="true"><span></span></p>

    <p class="gs-lead">
      この wiki は<strong>準備中</strong>です。<br />
      まだ記事はありません。
    </p>

    <div class="gs-note">
      <p style="margin:0 0 8px;">
        <strong>公開の時期が決まりましたら、このページでお知らせします。</strong>
        記事は、公式の発表など出典で裏が取れたものから順に掲載します。
      </p>
      <p style="margin:0;">
        最新の情報や正確な仕様は、公式サイトでご確認ください。
      </p>
    </div>

    <div class="gs-actions">
      <a class="gs-btn is-primary" href={w.officialUrl} target="_blank" rel="noopener noreferrer">
        公式サイトを開く
        <Icon name="lucide:external-link" />
      </a>
      {/* 実画面のリンクは末尾に « » を付けていた（「ホームページに戻る »」） */}
      <a class="gs-btn" href={withBase('/wikis/')} data-astro-reload>
        wiki 一覧へ<span aria-hidden="true"> »</span>
      </a>
    </div>
  </article>
</GenshinLayout>
