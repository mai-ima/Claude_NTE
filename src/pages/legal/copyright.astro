---
/**
 * 著作権・権利表記。
 *
 * 権利者名は `src/lib/wikis.ts` の rightsHolder / footer から取る。
 * **wiki を1つ足したらこのページは自動で追従する**（手で書き足さない）。
 */
import LegalPage from '../../components/LegalPage.astro';
import { Icon } from 'astro-icon/components';
import { withBase } from '../../lib/path';
import { WIKI_LIST } from '../../lib/wikis';
import { legalHref } from '../../lib/legal';

/** サイト名から**ゲームの名前だけ**を取り出す。
 *  例: 「原神 攻略wiki（準備中）」→「原神」／「NTE 完全攻略wiki」→「NTE」 */
const gameName = (siteName: string) =>
  siteName
    .replace(/（[^）]*）\s*$/, '') // 末尾の（準備中）など
    .replace(/\s*完全攻略wiki$/, '')
    .replace(/\s*攻略wiki$/, '')
    .replace(/\s*wiki$/, '')
    .trim();

/** 実在するゲームだけを並べる（α はマルチwiki機能の検証用のダミー） */
const games = WIKI_LIST.filter((w) => w.kind !== 'sample').map((w) => ({
  name: gameName(w.siteName),
  href: w.base ? `${w.base}/` : '/',
  // NTE だけ rightsHolder を持たない（フッターに書いてある）ので補う
  holder: w.rightsHolder ?? 'Hotta Studio / Perfect World Games',
  official: w.officialUrl,
}));
---

<LegalPage
  slug="copyright"
  description="各ゲームの権利者と、本サイトが書いた文章の扱いについてまとめています。"
>
  <p>
    本ページは、本サイトが取り扱う著作物の権利の帰属および本サイトの制作物の取扱いを定めるものです。
  </p>

  <h2>第1条（各ゲームに関する権利）</h2>
  <ol>
    <li>
      本サイトで取り扱う各ゲームの<strong>名称・画像・音声・映像・データ・世界観その他一切の権利は、
      各権利者に帰属します</strong>。本サイトはこれらの権利を主張しません。
    </li>
    <li>各ゲームおよび権利者は、次のとおりです。</li>
  </ol>

  <div style="overflow-x:auto;">
    <table>
      <thead>
        <tr>
          <th>ゲーム</th>
          <th>権利者</th>
          <th>公式サイト</th>
        </tr>
      </thead>
      <tbody>
        {
          games.map((g) => (
            <tr>
              <td>
                <a href={withBase(g.href)} data-astro-reload>
                  {g.name}
                </a>
              </td>
              <td>{g.holder}</td>
              <td>
                {g.official ? (
                  <a href={g.official} target="_blank" rel="noopener noreferrer">
                    公式
                    <Icon
                      name="lucide:external-link"
                      style="width:12px;height:12px;margin-left:3px;"
                    />
                  </a>
                ) : (
                  <span class="muted">—</span>
                )}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>


  <h2>第2条（画像の取扱い）</h2>
  <ol>
    <li>
      本サイトは、キャラクターの立ち絵・アイコン等の画像について、
      <strong>各権利者の公式サイトで公開されているものを、出典を明示したうえで掲載</strong>しています。
      これらの画像に関する権利は、第1条に定めるとおり各権利者に帰属します。
    </li>
    <li>
      公式に該当する画像が存在しない事項については、
      <strong>国内の攻略情報サイトが掲載する画像を引用する場合があります</strong>。
      この場合も出典を明示します。
    </li>
    <li>
      掲載している画像は、いずれも<strong>1点ごとに出どころと取得日を記録</strong>しています。
      権利者または掲載元からのお申し出があった場合は、第5条の手続により速やかに削除します。
    </li>
    <li>
      各 wiki の外観（配色・形状・余白等）は、対象ゲームの様式を参考に
      <strong>運営者が自ら記述したスタイルシートにより再現したもの</strong>です。
    </li>
    <li>
      公式のフォントは使用していません。表示に用いる書体は、閲覧される端末に
      標準で備わるものです。
    </li>
  </ol>

  <h2>第3条（引用の範囲）</h2>
  <ol>
    <li>
      本サイトは、解説のために必要な範囲でのみ、各権利者の著作物を引用します。
      引用にあたっては、引用部分と本サイトの記述とを明確に区別し、出典を示します。
    </li>
    <li>
      攻略情報サイトの記述を参考にした場合は、記事末尾の「出典」に掲載元の名称と
      該当ページへのリンクを示します。
    </li>
    <li>
      本サイトは、他の情報源の記述をそのまま書き写すことはしません。
      内容を確かめたうえで、本サイトの言葉で書き直しています。
    </li>
  </ol>

  <h2>第4条（本サイトの制作物）</h2>
  <ol>
    <li>
      解説文・構成・図表等、運営者が独自に作成した部分に関する権利は、運営者に帰属します。
    </li>
    <li>
      前項の利用条件は、<a href={withBase(legalHref('terms'))}>利用規約</a>第7条
      （引用・転載・リンク）に定めるところによります。出典を明示した引用は自由です。
    </li>
  </ol>

  <h2>第5条（権利者の皆様へ・削除のお申し出）</h2>
  <ol>
    <li>
      掲載内容に権利上の問題がある場合は、本ページ末尾の窓口までご連絡ください。
      <strong>ご連絡をいただき次第、速やかに確認のうえ、該当箇所の修正または削除を行います。</strong>
    </li>
    <li>
      お申し出の際は、次の事項をお知らせいただけると確認が早く進みます。
      <ul>
        <li>対象のページの URL と、該当箇所（見出し・画像のファイル名など）</li>
        <li>お申し出の根拠（権利の種類、権利者との関係）</li>
        <li>ご連絡先</li>
      </ul>
    </li>
    <li>
      お申し出の内容を確認できた場合、<strong>原則として受領から7日以内</strong>に
      該当箇所を削除または修正し、その結果をご連絡します。
      確認に時間を要する場合は、その旨をお知らせしたうえで、
      先に該当箇所の表示を停止することがあります。
    </li>
    <li>
      本条の手続は、権利者以外の方からのご指摘についても同様に受け付けます。
    </li>
  </ol>
</LegalPage>
