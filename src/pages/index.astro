---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/path';
import { SECTIONS, elementMeta, roleMeta } from '../lib/nav';
import { TOOLS } from '../components/tools/registry';
import Avatar from '../components/Avatar.astro';
import { RELEASE_NOTES } from '../data/releaseNotes';
import { loadNavSections, recentEntries, publishedEntries, titleOf, enNameOf, hrefOf, loadEvents } from '../lib/content';

const sections = await loadNavSections();
const countOf = (c: string) => sections.find((s) => s.collection === c)?.items.length ?? 0;
const totalArticles = sections.reduce((sum, s) => sum + s.items.length, 0);

const recent = await recentEntries(6);

// 現在のライブ運営（開催中＋直近の予定）を上部に出す。
// 静的ビルドの焼き付き対策として候補を多めに描画し、表示はクライアントで再判定して最大4件に絞る。
const allEvents = await loadEvents();
const liveEvents = allEvents.filter((e) => e.phase === 'current' || e.phase === 'upcoming').slice(0, 8);
const KIND_LABEL: Record<string, string> = {
  banner: 'ピックアップ',
  'weapon-banner': '武器ガチャ',
  event: 'イベント',
};

// 注目キャラ: ティアが高い or S-Class を数体
const chars = await publishedEntries('characters');
const featured = [...chars]
  .sort((a: any, b: any) => {
    const t = { SS: 0, S: 1, A: 2, B: 3, C: 4 } as Record<string, number>;
    return (t[a.data.tier ?? 'Z'] ?? 9) - (t[b.data.tier ?? 'Z'] ?? 9);
  })
  .slice(0, 6);

const latest = RELEASE_NOTES[0];
---

<BaseLayout title="ホーム">
  <div class="layout">
    <div class="content">
      <section class="page-head hero">
        <p class="eyebrow">NTE 完全攻略wiki</p>
        <h1>Neverness to Everness を、ここに。</h1>
        <p class="lead">
          オープンワールド都市RPG「NTE（ネバエバ）」の攻略情報を網羅する非公式ファンwiki。
          キャラ・異能連環・ガチャ・ストーリー/世界観・用語・ロケーション・ビークル・アイテムのデータベースに加え、
          開催中のガチャ/イベント、天井トラッカーやチームビルダーなどの便利ツールも。<strong>Ver.1.1 対応・随時更新</strong>。
        </p>
        <div class="meta-row">
          <a class="btn btn-primary" href={withBase('/characters/')}>
            <Icon name="lucide:users" /> キャラを見る
          </a>
          <a class="btn" href={withBase('/tools/')}>
            <Icon name="lucide:wrench" /> ツール
          </a>
        </div>
        <div class="stat-band">
          <div class="stat"><span class="stat-num">{countOf('characters')}</span><span class="stat-label">キャラ</span></div>
          <div class="stat"><span class="stat-num">{countOf('terms')}</span><span class="stat-label">用語</span></div>
          <div class="stat"><span class="stat-num">{totalArticles}</span><span class="stat-label">記事</span></div>
          <div class="stat"><span class="stat-num">{TOOLS.length + 3}</span><span class="stat-label">ツール</span></div>
        </div>
      </section>

      {
        liveEvents.length > 0 && (
          <section style="margin-top:8px;" data-live-section hidden>
            <div class="row row-between">
              <h2 style="margin:0;">
                <Icon name="lucide:radio" style="width:20px;height:20px;color:var(--accent);vertical-align:-3px;" />{' '}
                現在のピックアップ / 開催中
              </h2>
              <a class="text-sm" href={withBase('/events/')}>
                すべて見る
              </a>
            </div>
            <div class="grid grid-cards" style="margin-top:16px;" data-live-list>
              {liveEvents.map((e) => (
                <a
                  class="card card-pad card-link live-event"
                  href={e.href}
                  data-start-ms={e.startMs ?? ''}
                  data-end-ms={e.endMs ?? ''}
                  hidden
                >
                  <div class="row row-between" style="align-items:flex-start;gap:8px;">
                    <span style="font-weight:700;">{e.title}</span>
                    <span class="badge" data-status>
                      {e.daysLeft !== undefined
                        ? e.phase === 'current'
                          ? `あと${e.daysLeft}日`
                          : `${e.daysLeft}日後`
                        : '常設'}
                    </span>
                  </div>
                  <div class="cluster" style="margin-top:8px;">
                    <span class="badge badge-accent">{KIND_LABEL[e.kind] ?? e.kind}</span>
                    {e.featured.map((f) => (
                      <span class="badge">{f}</span>
                    ))}
                  </div>
                </a>
              ))}
            </div>
          </section>
        )
      }

      <section style="margin-top:40px;">
        <h2>データベース</h2>
        <div class="grid grid-cards" style="margin-top:16px;">
          {
            SECTIONS.map((s) => (
              <a class="card card-pad card-link" href={withBase(s.href)}>
                <div class="row" style="gap:10px;align-items:flex-start;">
                  <span class="badge badge-accent" style="height:34px;width:34px;padding:0;border-radius:9px;justify-content:center;">
                    <Icon name={`lucide:${s.icon}`} style="width:18px;height:18px;" />
                  </span>
                  <div>
                    <div style="font-weight:700;">{s.label}</div>
                    <div class="muted text-sm">{countOf(s.collection)} 記事</div>
                  </div>
                </div>
                <p class="muted text-sm" style="margin-top:8px;">{s.blurb}</p>
              </a>
            ))
          }
        </div>
      </section>

      {
        featured.length > 0 && (
          <section style="margin-top:40px;">
            <div class="row row-between">
              <h2 style="margin:0;">注目のエスパー</h2>
              <a class="text-sm" href={withBase('/characters/')}>
                すべて見る
              </a>
            </div>
            <div class="grid grid-cards" style="margin-top:16px;">
              {featured.map((entry: any) => {
                const d = entry.data;
                const em = elementMeta(d.element);
                return (
                  <a
                    class="card card-pad card-link char-card"
                    href={hrefOf('characters', entry.id)}
                    style={`--el:${em.hue}`}
                  >
                    <div class="row" style="gap:10px;align-items:center;">
                      <Avatar name={enNameOf(entry)} element={d.element} rarity={d.rarity} size={42} />
                      <span style="font-weight:800;">{titleOf(entry)}</span>
                    </div>
                    <div class="cluster" style="margin-top:10px;">
                      <span class="el-badge" style={`--el:${em.hue}`}>
                        <span class="el-dot" />
                        {em.label}
                      </span>
                      <span class="badge">
                        {roleMeta(d.role).label.replace(/\s*\(.*\)/, '')}
                      </span>
                    </div>
                  </a>
                );
              })}
            </div>
          </section>
        )
      }

      <div class="grid" style="margin-top:40px;grid-template-columns:1fr;gap:32px;">
        <section>
          <h2>最近更新した記事</h2>
          {
            recent.length > 0 ? (
              <ul class="list-reset stack" style="margin-top:16px;">
                {recent.map((e) => (
                  <li>
                    <a class="card card-pad card-link" href={e.href}>
                      <div class="row row-between">
                        <span style="font-weight:600;">{e.title}</span>
                        <span class="muted text-sm">{e.updated.toLocaleDateString('ja-JP', { timeZone: 'Asia/Tokyo' })}</span>
                      </div>
                      <span class="badge" style="margin-top:6px;">{e.sectionLabel}</span>
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="muted" style="margin-top:12px;">記事がまだありません。</p>
            )
          }
        </section>

        <section>
          <h2>ツール</h2>
          <div class="grid grid-cards" style="margin-top:16px;">
            {
              TOOLS.map((t) => (
                <a class="card card-pad card-link" href={withBase(`/tools/${t.id}/`)}>
                  <div class="row" style="gap:10px;align-items:flex-start;">
                    <Icon name={`lucide:${t.icon}`} style="width:20px;height:20px;color:var(--accent);flex:none;margin-top:2px;" />
                    <div>
                      <div style="font-weight:700;">{t.name}</div>
                      <p class="muted text-sm" style="margin-top:2px;">{t.description}</p>
                    </div>
                  </div>
                </a>
              ))
            }
          </div>
        </section>

        {
          latest && (
            <section>
              <div class="row row-between">
                <h2 style="margin:0;">更新履歴</h2>
                <a class="text-sm" href={withBase('/release-notes/')}>
                  すべて見る
                </a>
              </div>
              <div class="card card-pad" style="margin-top:16px;">
                <div class="cluster">
                  <span class="badge badge-accent">{latest.version}</span>
                  <span class="muted text-sm">
                    {latest.date}・{latest.title}
                  </span>
                </div>
                <ul class="text-sm" style="margin-top:10px;padding-left:1.2em;">
                  {latest.changes.slice(0, 4).map((c) => (
                    <li>{c}</li>
                  ))}
                </ul>
              </div>
            </section>
          )
        }
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // トップの「現在のピックアップ/開催中」バンドを閲覧時刻で再判定（静的焼き付き対策）。
  // 終了済みは除外、開催中→予定の順に最大4件だけ表示する。
  (function () {
    const now = Date.now();
    const DAY = 86_400_000;
    const ceilDays = (to: number) => Math.max(0, Math.ceil((to - now) / DAY));
    const section = document.querySelector<HTMLElement>('[data-live-section]');
    const list = document.querySelector<HTMLElement>('[data-live-list]');
    if (!section || !list) return;
    const cards = Array.from(list.querySelectorAll<HTMLElement>('.live-event'));
    const live: { el: HTMLElement; rank: number; key: number }[] = [];
    for (const el of cards) {
      const sRaw = el.getAttribute('data-start-ms');
      const eRaw = el.getAttribute('data-end-ms');
      const startMs = sRaw ? Number(sRaw) : null;
      const endMs = eRaw ? Number(eRaw) : null;
      el.hidden = true;
      if (endMs != null && now >= endMs) continue; // 終了は出さない
      const badge = el.querySelector<HTMLElement>('[data-status]');
      if (startMs != null && now < startMs) {
        const d = ceilDays(startMs);
        if (badge) {
          badge.textContent = `${d}日後`;
          badge.classList.remove('badge-accent');
        }
        live.push({ el, rank: 1, key: d });
      } else {
        if (badge) {
          badge.textContent = endMs != null ? `あと${ceilDays(endMs)}日` : '常設';
          badge.classList.add('badge-accent');
        }
        live.push({ el, rank: 0, key: endMs != null ? ceilDays(endMs) : 9999 });
      }
    }
    live.sort((a, b) => a.rank - b.rank || a.key - b.key);
    const shown = live.slice(0, 4);
    for (const { el } of shown) {
      el.hidden = false;
      list.appendChild(el);
    }
    section.hidden = shown.length === 0;
  })();
</script>
