---
import EntityDetail from '../../components/EntityDetail.astro';
import { elementMeta } from '../../lib/nav';
import { detailPaths, renderEntry, baseDetailProps } from '../../lib/detail';
import type { Row, Pill } from '../../components/EntityDetail.astro';

const TYPE_JA: Record<string, string> = {
  anomaly: 'アノマリー', boss: 'ボス', elite: 'エリート', mob: '雑魚',
};

export async function getStaticPaths() {
  return detailPaths('enemies', { relatedBy: 'type' });
}
const { entry, prev, next, related } = Astro.props;
const { Content, headings } = await renderEntry(entry);
const d = entry.data as any;
const hasWeak = d.weakness && d.weakness !== '—';
const pills: Pill[] = [];
if (hasWeak) pills.push({ kind: 'plain', value: `弱点 ${elementMeta(d.weakness).label}（${elementMeta(d.weakness).en}）` });
const rows: Row[] = [{ k: '種別', v: TYPE_JA[d.type] ?? d.type }];
if (d.element) rows.push({ k: '属性', v: `${elementMeta(d.element).label}（${d.element}）` });
if (hasWeak) rows.push({ k: '弱点', v: `${elementMeta(d.weakness).label}（${elementMeta(d.weakness).en}）` });
if (d.location && d.location !== '—') rows.push({ k: '出現', v: d.location });
---
<EntityDetail
  {...baseDetailProps('enemies', entry, prev, next)}
  pills={pills}
  rows={rows}
  headings={headings}
  related={related}
  relatedLabel={`${TYPE_JA[d.type] ?? d.type}の敵`}
>
  <Content />
</EntityDetail>
