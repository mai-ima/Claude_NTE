---
import BaseLayout from '../layouts/BaseLayout.astro';
import SettingsPanel from '../components/SettingsPanel';
import { RELEASE_NOTES } from '../data/releaseNotes';
import { withBase } from '../lib/path';

const currentVersion = RELEASE_NOTES[0]?.version ?? '';
---

<BaseLayout title="設定">
  <div class="layout">
    <div class="content" style="max-width:720px;margin:0 auto;">
      <section class="page-head">
        <p class="eyebrow">設定</p>
        <h1>設定</h1>
        <p class="lead">配色テーマと UIモードの切り替え、表示と機能の調整、データのバックアップ。</p>
      </section>

      <SettingsPanel client:only="preact" />

      <p class="muted text-sm" style="margin-top:24px;text-align:center;">
        現在のバージョン: <strong>{currentVersion}</strong> ／
        <a href={withBase('/release-notes/')}>更新履歴</a> ／
        <a href={withBase('/notices/')}>お知らせ</a> ／
        <a href={withBase('/legal/')}>規約・ポリシー</a>
      </p>
      {/* 管理ページ。URL を知らないと入れないのは不便なので置くが、
          合言葉が要るので目立たせない（検索にも載せていない）。 */}
      <p class="muted text-sm" style="margin-top:8px;text-align:center;opacity:0.7;">
        <a href={withBase('/admin/')}>管理</a>
      </p>
    </div>
  </div>
</BaseLayout>
