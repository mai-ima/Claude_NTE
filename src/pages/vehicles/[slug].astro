---
import EntityDetail from '../../components/EntityDetail.astro';
import { detailPaths, renderEntry, baseDetailProps } from '../../lib/detail';
import type { Row, Pill } from '../../components/EntityDetail.astro';

export async function getStaticPaths() {
  return detailPaths('vehicles', { relatedBy: 'type' });
}
const { entry, prev, next, related } = Astro.props;
const { Content, headings } = await renderEntry(entry);
const d = entry.data as any;

const TYPE_LABEL: Record<string, string> = {
  scooter: 'スクーター',
  bike: 'バイク',
  car: '車',
  special: '特殊・報酬',
};
const rows: Row[] = [];
rows.push({ k: '種別', v: TYPE_LABEL[d.type] ?? d.type });
if (d.price) rows.push({ k: '価格', v: d.price });
if (d.topSpeed) rows.push({ k: '最高速', v: d.topSpeed });
if (d.shop) rows.push({ k: '購入店', v: d.shop });
if (d.acquisition) rows.push({ k: '入手方法', v: d.acquisition });
if (d.perk) rows.push({ k: '同乗効果・特性', v: d.perk });

const pills: Pill[] = [{ kind: 'plain', value: TYPE_LABEL[d.type] ?? d.type }];
---
<EntityDetail
  {...baseDetailProps('vehicles', entry, prev, next)}
  pills={pills}
  rows={rows}
  headings={headings}
  related={related}
  relatedLabel={`${TYPE_LABEL[d.type] ?? d.type}の他のビークル`}
>
  <Content />
</EntityDetail>
