---
/**
 * 管理ページ（/admin/）。
 *
 * ★ このページの限界を先に書く（隠すと嘘になる）
 *
 *   本サイトは**静的サイト**で、サーバー側のプログラムもデータベースもない。
 *   したがって
 *     - 合言葉の照合は**ブラウザの中**で行っている（サーバー認証ではない）
 *     - ここで作ったお知らせ・切り替えた状態は **その端末にだけ**保存される
 *   の2つが避けられない。**画面にもそのまま書いてある**。
 *   全員に見せる変更は `src/lib/notices.ts` / `src/lib/site-state.ts` を書き換えて
 *   ビルドし直す（＝配る）。その手順もこのページに載せてある。
 *
 * 合言葉は環境変数 `ADMIN_PASSCODE` から取り、**ビルド時に SHA-256 にしてから**
 * 埋め込む。生の合言葉は出力に含めない（総当たりは防げないので、これは
 * 「肩越しに見えない」程度の意味しかない。過大な約束をしない）。
 *
 * ---- 2026-09-12 の刷新で直したこと ---------------------------------------
 *
 * | 症状 | 原因 | 直し方 |
 * | --- | --- | --- |
 * | 削除が別のお知らせを消しうる | 表示時の**並び順の番号**で `splice` していた | **id で消す**（`filter`） |
 * | 同じ日に2件書き出すと id が衝突 | id が日付だけだった | **時刻を足して一意にする** |
 * | 「maintenance にしました」と英語が出る | 内部の値をそのまま表示していた | **ラベルを引いて出す** |
 * | 合言葉の照合が無反応になることがある | `digest()` の失敗を拾っていなかった | `.catch` を付けた |
 * | 同じページに留まると操作が二重に起きる | 画面の入れ替えでリスナーが重なる | **`data-bound` で1回だけ**にする |
 * | 通知が `alert()` で作業が止まる | — | **画面内のメッセージ**に置き換えた |
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { createHash } from 'node:crypto';
import fs from 'node:fs';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/path';
import {
  SITE_MODES,
  DEFAULT_SITE_STATE,
  STATE_KEY,
  NOTICES_KEY,
  ADMIN_KEY,
  GATE_CLOSED_KEY,
  modeOf,
} from '../../lib/site-state';
import { NOTICE_LEVELS, NOTICES } from '../../lib/notices';
import { WIKI_LIST } from '../../lib/wikis';
import { STORE_PREFIX } from '../../lib/store';
import { FAVORITES_NAME, HISTORY_NAME, HISTORY_LIMIT } from '../../lib/user-data';
import {
  IMAGE_SOURCES,
  IMAGES_KEY,
  DEFAULT_IMAGE_SOURCE,
  imageSourceOf,
} from '../../lib/images';

const passcode = import.meta.env.ADMIN_PASSCODE ?? 'nte-admin';
const passHash = createHash('sha256').update(String(passcode)).digest('hex');
/** 環境変数が未設定なら、その旨を画面に出す（既定の合言葉は公開リポジトリにある） */
const usingDefaultPass = !import.meta.env.ADMIN_PASSCODE;

const today = new Date().toISOString().slice(0, 10);

/**
 * 画像がいくつ使える状態かを数える（ビルド時）。
 *
 * 「公式の画像も使う」に切り替えても何も出ない、ということが起きる。
 * 原因は**登録が0件**なのだが、画面に出していないと故障に見える。
 * ここで実数を出して、切り替えの前に分かるようにする。
 */
const charEntries = await getCollection('characters');
const officialCount = charEntries.filter((c) => (c.data as { officialImage?: string }).officialImage).length;
const localDir = 'public/images/characters';
const localCount = fs.existsSync(localDir)
  ? fs.readdirSync(localDir).filter((f) => /\.(webp|avif|png|jpe?g)$/i.test(f)).length
  : 0;

/**
 * 記事の状況を数える（ビルド時）。
 *
 * 「どれだけ書けていて、どこに穴があるか」を1画面で見るための集計。
 * 下書き・出典なし・確認が古いものは、**直す順番を決める手がかり**になる。
 * 数字はビルドした時点のもので、この端末の操作とは関係がない。
 */
const STALE_DAYS = 120;
const staleBefore = Date.now() - STALE_DAYS * 24 * 60 * 60 * 1000;

interface WikiStat {
  id: string;
  name: string;
  total: number;
  draft: number;
  noSource: number;
  stale: number;
  collections: { collection: string; label: string; href: string; count: number; draft: number }[];
}

const wikiStats: WikiStat[] = [];
for (const w of WIKI_LIST) {
  const stat: WikiStat = { id: w.id, name: w.siteName, total: 0, draft: 0, noSource: 0, stale: 0, collections: [] };
  for (const sec of w.sections) {
    let all: { data: Record<string, unknown> }[] = [];
    try {
      all = (await getCollection(sec.collection as Parameters<typeof getCollection>[0])) as unknown as {
        data: Record<string, unknown>;
      }[];
    } catch {
      // まだ記事が1件も無いコレクション（準備中の wiki）は空として扱う
      all = [];
    }
    let draft = 0;
    for (const e of all) {
      const d = e.data;
      if (d.status === 'draft') draft++;
      // ダミーの wiki（実在しないゲームの検証用データ）は出典が存在しないので数えない。
      // ここを数えると「出典なし8本」と出て、直しようのない警告が居座る。
      if (w.kind !== 'sample') {
        const sources = d.sources;
        if (!Array.isArray(sources) || sources.length === 0) stat.noSource++;
      }
      // 「確認した日」があればそちらを見る（本文を変えていなくても確かめていれば新しい）
      const when = (d.checked ?? d.updated) as Date | undefined;
      if (when instanceof Date && when.getTime() < staleBefore) stat.stale++;
    }
    stat.total += all.length;
    stat.draft += draft;
    stat.collections.push({
      collection: sec.collection,
      label: sec.label,
      href: sec.href,
      count: all.length,
      draft,
    });
  }
  if (stat.total > 0) wikiStats.push(stat);
}
const totalArticles = wikiStats.reduce((n, w) => n + w.total, 0);
const totalDraft = wikiStats.reduce((n, w) => n + w.draft, 0);
const totalNoSource = wikiStats.reduce((n, w) => n + w.noSource, 0);
const totalStale = wikiStats.reduce((n, w) => n + w.stale, 0);

/** 画面に出すためのラベル表（内部の値をそのまま見せないため JS へ渡す） */
const modeLabels = Object.fromEntries(SITE_MODES.map((m) => [m.value, m.label]));
const levelLabels = Object.fromEntries(NOTICE_LEVELS.map((l) => [l.value, l.label]));

/** この端末に何が保存されるかの一覧（「この端末のデータ」タブに出す） */
const STORED = [
  { key: STATE_KEY, label: 'サイトの状態', hint: '通常 / メンテナンス / 停止と、画面に出す文' },
  { key: NOTICES_KEY, label: 'この端末のお知らせ', hint: 'ここで作ったお知らせ' },
  { key: IMAGES_KEY, label: 'キャラクターの画像', hint: '絵をどこから出すか' },
  { key: ADMIN_KEY, label: 'ロックを外した印', hint: '次に開いたときも開いたままにする' },
  {
    key: `${STORE_PREFIX}${FAVORITES_NAME}`,
    label: '保存したページ',
    hint: '記事の「保存」で足したもの',
  },
  {
    key: `${STORE_PREFIX}${HISTORY_NAME}`,
    label: '最近見たページ',
    hint: `開いた記事の記録（新しい方から ${HISTORY_LIMIT} 件まで）`,
  },
];

const TABS = [
  { id: 'state', label: 'サイトの状態', icon: 'toggle-left' },
  { id: 'notices', label: 'お知らせ', icon: 'megaphone' },
  { id: 'view', label: '表示', icon: 'image' },
  { id: 'content', label: '記事', icon: 'file-text' },
  { id: 'data', label: 'この端末のデータ', icon: 'database' },
];
---

{/* 読者向けのページではないので検索には載せない（noindex） */}
<BaseLayout title="管理" description="サイトの状態とお知らせを切り替えるページです。" noindex>
  <div class="layout">
    <div class="content admin-page">
      <nav class="text-sm muted cluster" style="margin-bottom:16px;" aria-label="パンくず">
        <a href={withBase('/')}>ホーム</a>
        <span aria-hidden="true"> › </span>
        <span>管理</span>
      </nav>

      <section class="page-head">
        <p class="eyebrow">Admin</p>
        <h1>管理</h1>
        <p class="lead">サイトの状態の切り替えと、お知らせの作成・削除ができます。</p>
      </section>

      {/* ---- ロック画面 ------------------------------------------------ */}
      <section id="admin-lock" class="card card-pad admin-lock">
        <div class="admin-lock-icon" aria-hidden="true">
          <Icon name="lucide:lock" />
        </div>
        <h2>合言葉を入力してください</h2>

        <form id="admin-form" class="admin-form admin-lock-form">
          <label class="admin-field">
            <span>合言葉</span>
            <input
              type="password"
              id="admin-pass"
              autocomplete="current-password"
              required
              placeholder="••••••••"
            />
          </label>
          <button class="btn btn-primary" type="submit">
            <Icon name="lucide:log-in" />開く
          </button>
        </form>
        <p id="admin-error" class="admin-error" role="alert" hidden></p>

        {/* .callout は「アイコン＋本文」の横並び。段落を直に並べると**段落ごとに列**に
            なってスマホで1文字ずつ折り返すので、本文は必ず1つの要素にまとめる。 */}
        <div class="callout callout-info admin-lock-note">
          <div>
            <p style="margin:0 0 8px;"><strong>この鍵でできること・できないこと</strong></p>
            <p style="margin:0 0 8px;">
              本サイトはサーバーを持たない静的サイトです。合言葉の照合は
              <strong>お使いのブラウザの中だけ</strong>で行っており、
              サーバーによる認証ではありません。ここで行った変更も
              <strong>この端末にだけ</strong>保存され、ほかの方の画面は変わりません。
            </p>
            <p style="margin:0;">
              全員に見える変更（お知らせの公開、サイト全体のメンテナンス表示）は、
              ソースの <code>src/lib/notices.ts</code> と <code>src/lib/site-state.ts</code>
              を書き換えて公開し直す形になります。手順はロックを解除すると表示されます。
            </p>
          </div>
        </div>
        {
          usingDefaultPass && (
            <p class="muted text-sm" style="margin-top:12px;">
              合言葉は環境変数 <code>ADMIN_PASSCODE</code> で設定できます。未設定のあいだは
              初期値のままです。
            </p>
          )
        }
      </section>

      {/* ---- 管理画面 -------------------------------------------------- */}
      <div id="admin-panel" hidden>
        <div class="admin-bar">
          <p class="badge badge-accent" style="margin:0;">
            <Icon name="lucide:unlock" />ロック解除中
          </p>
          <span class="muted text-sm" id="admin-now" aria-live="polite"></span>
          <button class="btn btn-ghost" type="button" id="admin-logout">
            <Icon name="lucide:log-out" />ロックする
          </button>
        </div>

        {/* タブ。中身はすべて DOM にあり、表示だけを切り替える */}
        <div class="admin-tabs" role="tablist" aria-label="管理の項目" id="admin-tabs">
          {
            TABS.map((t, i) => (
              <button
                class="admin-tab"
                type="button"
                role="tab"
                id={`tab-${t.id}`}
                aria-controls={`pane-${t.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                data-tab={t.id}
              >
                <Icon name={`lucide:${t.icon}`} />
                {t.label}
              </button>
            ))
          }
        </div>

        {/* -- サイトの状態 -- */}
        <section
          class="card card-pad admin-pane"
          role="tabpanel"
          id="pane-state"
          aria-labelledby="tab-state"
          data-pane="state"
        >
          <h2 style="margin-top:0;">サイトの状態</h2>
          <p class="muted text-sm">
            通常以外にすると、全ページに案内が重なって表示されます。
            <strong>この端末のブラウザにだけ</strong>効きます。
          </p>
          <div class="admin-modes" id="admin-modes" role="group" aria-label="サイトの状態">
            {
              SITE_MODES.map((m) => (
                <button class="admin-mode" type="button" data-mode={m.value} aria-pressed="false">
                  <span class="admin-mode-head">
                    <Icon name={`lucide:${m.icon}`} />
                    {m.label}
                  </span>
                  <span class="muted text-sm">{m.hint}</span>
                </button>
              ))
            }
          </div>

          <div class="admin-form" style="margin-top:16px;">
            <label class="admin-field">
              <span>画面に出す文（空なら既定の文）</span>
              <textarea id="admin-msg" rows="3" placeholder="内容の更新作業を行っています。"
              ></textarea>
            </label>
            <label class="admin-field">
              <span>再開の目安（空なら出しません）</span>
              <input type="text" id="admin-until" placeholder="9月10日 12時ごろ" />
            </label>
            <div class="cluster">
              <button class="btn btn-primary" type="button" id="admin-save-state">
                <Icon name="lucide:save" />この状態にする
              </button>
              <button class="btn btn-ghost" type="button" id="admin-reset-state">
                <Icon name="lucide:rotate-ccw" />通常に戻す
              </button>
            </div>
          </div>
          <p class="muted text-sm" style="margin-top:12px;">
            公開されている既定の状態: <strong>{modeOf(DEFAULT_SITE_STATE.mode).label}</strong>
            （<code>src/lib/site-state.ts</code> の <code>DEFAULT_SITE_STATE</code>）
          </p>
        </section>

        {/* -- お知らせ -- */}
        <section
          class="card card-pad admin-pane"
          role="tabpanel"
          id="pane-notices"
          aria-labelledby="tab-notices"
          data-pane="notices"
          hidden
        >
          <h2 style="margin-top:0;">お知らせ</h2>
          <p class="muted text-sm">
            作成したお知らせは<a href={withBase('/notices/')}>お知らせ一覧</a>の下部に出ます。
            <strong>この端末のブラウザにだけ</strong>保存されます。
          </p>

          <div class="admin-form" style="margin-top:12px;">
            <label class="admin-field">
              <span>日付</span>
              <input type="date" id="notice-date" value={today} />
            </label>
            <label class="admin-field">
              <span>種類</span>
              <select id="notice-level">
                {NOTICE_LEVELS.map((l) => <option value={l.value}>{l.label}</option>)}
              </select>
            </label>
            <label class="admin-field">
              <span>見出し</span>
              <input type="text" id="notice-title" placeholder="メンテナンスのお知らせ" />
            </label>
            <label class="admin-field">
              <span>本文（空行で段落が分かれます）</span>
              <textarea id="notice-body" rows="5"></textarea>
            </label>
            <div class="cluster">
              <button class="btn btn-primary" type="button" id="notice-add">
                <Icon name="lucide:plus" />この端末に追加
              </button>
              <button class="btn btn-ghost" type="button" id="notice-copy">
                <Icon name="lucide:clipboard-copy" />全員に配る形で書き出す
              </button>
            </div>
          </div>

          <h3 style="margin-top:24px;">この端末のお知らせ</h3>
          <div id="notice-admin-list" class="admin-list"></div>

          <h3 style="margin-top:24px;">公開中のお知らせ（全員に見えるもの）</h3>
          <div class="admin-list">
            {
              NOTICES.map((n) => (
                <div class="admin-row">
                  <div>
                    <strong>{n.title}</strong>
                    <span class="muted text-sm"> {n.date} / {levelLabels[n.level] ?? n.level}</span>
                  </div>
                  <span class="badge">公開中</span>
                </div>
              ))
            }
          </div>
          <p class="muted text-sm" style="margin-top:8px;">
            こちらは <code>src/lib/notices.ts</code> にあります。削除・修正はソースを直します。
          </p>
        </section>

        {/* -- 表示（キャラクター画像の出どころ） -- */}
        <section
          class="card card-pad admin-pane"
          role="tabpanel"
          id="pane-view"
          aria-labelledby="tab-view"
          data-pane="view"
          hidden
        >
          <h2 style="margin-top:0;">キャラクターの画像</h2>
          <p class="muted text-sm">
            見た目を <strong>Base</strong> にしているときだけ、キャラクターの図形に絵を重ねます。
            ほかの見た目では、これまでどおり色と頭文字で作った図形のままです。
            <strong>この端末のブラウザにだけ</strong>効きます。
          </p>
          <div class="admin-modes" id="admin-images" role="group" aria-label="画像の出どころ">
            {
              IMAGE_SOURCES.map((s) => (
                <button class="admin-mode" type="button" data-img={s.value} aria-pressed="false">
                  <span class="admin-mode-head">
                    <Icon name={`lucide:${s.icon}`} />
                    {s.label}
                  </span>
                  <span class="muted text-sm">{s.hint}</span>
                </button>
              ))
            }
          </div>
          <div class="callout callout-info" style="margin-top:14px;">
            <Icon name="lucide:info" />
            <div>
              <p style="margin:0;">
                画像は <code>public/images/characters/</code> に、記事のIDと同じ名前で置きます
                （例: <code>zanko.webp</code>）。置いていないキャラは図形のままです。
              </p>
              <p style="margin:8px 0 0;">
                ゲームの画像・イラストの権利は各運営元にあります。掲載する場合は、
                権利者の案内（二次利用のガイドライン等）をご確認ください。
              </p>
            </div>
          </div>
          <div class="admin-list" style="margin-top:14px;">
            <div class="admin-row">
              <div>
                <strong>置いてある画像</strong>
                <br />
                <span class="muted text-sm">public/images/characters/ にあるファイルの数</span>
              </div>
              <span class:list={['badge', localCount > 0 && 'badge-accent']}>{localCount} 件</span>
            </div>
            <div class="admin-row">
              <div>
                <strong>公式の画像の登録</strong>
                <br />
                <span class="muted text-sm">記事の officialImage に書かれた URL の数</span>
              </div>
              <span class:list={['badge', officialCount > 0 && 'badge-accent']}>{officialCount} 件</span>
            </div>
          </div>
          {
            officialCount === 0 && (
              <div class="callout callout-warning" style="margin-top:12px;">
                <Icon name="lucide:alert-circle" />
                <div>
                  <p style="margin:0;">
                    <strong>公式の画像はまだ1件も登録されていません。</strong>
                    「公式の画像も使う」に切り替えても、参照する URL が無いため表示は変わりません。
                  </p>
                  <p style="margin:8px 0 0;">
                    記事の frontmatter に <code>officialImage: https://…</code> を書くと、ここの数が増えます。
                  </p>
                </div>
              </div>
            )
          }
          <p class="muted text-sm" style="margin-top:12px;">
            公開されている既定: <strong>{imageSourceOf(DEFAULT_IMAGE_SOURCE).label}</strong>
            （<code>src/lib/images.ts</code> の <code>DEFAULT_IMAGE_SOURCE</code>）
          </p>
        </section>

        {/* -- 記事 -- */}
        <section
          class="card card-pad admin-pane"
          role="tabpanel"
          id="pane-content"
          aria-labelledby="tab-content"
          data-pane="content"
          hidden
        >
          <h2 style="margin-top:0;">記事</h2>
          <p class="muted text-sm">
            いま何本あり、どこに穴があるかをまとめています。数字は<strong>ビルドした時点</strong>のもので、
            この端末の操作とは関係ありません。
          </p>

          <div class="stat-band" style="margin-top:16px;">
            <div class="stat"><span class="stat-num">{totalArticles}</span><span class="stat-label">記事</span></div>
            <div class="stat"><span class="stat-num">{totalDraft}</span><span class="stat-label">要確認の下書き</span></div>
            <div class="stat"><span class="stat-num">{totalNoSource}</span><span class="stat-label">出典なし</span></div>
            <div class="stat"><span class="stat-num">{totalStale}</span><span class="stat-label">{STALE_DAYS}日以上そのまま</span></div>
          </div>

          {
            totalNoSource > 0 && (
              <div class="callout callout-warning" style="margin-top:16px;">
                <Icon name="lucide:alert-circle" />
                <div>
                  <p style="margin:0;">
                    <strong>出典の無い記事が {totalNoSource} 本あります。</strong>
                    このサイトは出典で裏が取れた内容だけを載せる決まりなので、先に埋めるのが安全です。
                  </p>
                </div>
              </div>
            )
          }

          {
            wikiStats.map((w) => (
              <div style="margin-top:24px;">
                <h3 style="margin:0 0 8px;">{w.name}</h3>
                <div class="admin-list">
                  {w.collections
                    .filter((c) => c.count > 0)
                    .map((c) => (
                      <div class="admin-row">
                        <div>
                          {/* 別の wiki へ渡るリンクは、見た目ごと切り替えるために
                              いったん読み込み直す（→ scripts/check-ui.mjs が見ている） */}
                          <a
                            href={withBase(c.href)}
                            style="font-weight:700;"
                            data-astro-reload={w.id !== 'nte' ? '' : undefined}
                          >
                            {c.label}
                          </a>
                          <div class="muted text-sm">{c.collection}</div>
                        </div>
                        <span class="cluster" style="gap:6px;">
                          {c.draft > 0 && <span class="badge">下書き {c.draft}</span>}
                          <span class="badge badge-accent">{c.count} 件</span>
                        </span>
                      </div>
                    ))}
                </div>
              </div>
            ))
          }

          <h3 style="margin-top:28px;">データの書き出し</h3>
          <p class="muted text-sm">
            全記事を機械が読める形（JSON）でも出しています。アプリから読むときや、
            別の置き場へ移すときに使います。出しているのは<strong>公開済みの記事だけ</strong>で、下書きは入りません。
          </p>
          <div class="admin-list">
            <div class="admin-row">
              <div>
                <a href={withBase('/api/index.json')} style="font-weight:700;">
                  目次
                </a>
                <div class="muted text-sm">/api/index.json</div>
              </div>
              <span class="badge">{wikiStats.length} wiki</span>
            </div>
            <div class="admin-row">
              <div>
                <span style="font-weight:700;">各コレクション</span>
                <div class="muted text-sm">/api/&lt;コレクション名&gt;.json</div>
              </div>
              <span class="badge">{wikiStats.reduce((n, w) => n + w.collections.filter((c) => c.count > 0).length, 0)} 本</span>
            </div>
          </div>
        </section>

        {/* -- この端末のデータ -- */}
        <section
          class="card card-pad admin-pane"
          role="tabpanel"
          id="pane-data"
          aria-labelledby="tab-data"
          data-pane="data"
          hidden
        >
          <h2 style="margin-top:0;">この端末のデータ</h2>
          <p class="muted text-sm">
            管理の操作は、すべて<strong>この端末のブラウザの中</strong>に保存されます。
            いま何が入っているかを確認して、書き出したり消したりできます。
          </p>
          <div class="admin-list" id="admin-stored"></div>
          <div class="cluster" style="margin-top:16px;">
            <button class="btn btn-ghost" type="button" id="admin-export">
              <Icon name="lucide:clipboard-copy" />内容を書き出す
            </button>
            <button class="btn btn-ghost" type="button" id="admin-clear">
              <Icon name="lucide:trash-2" />管理のデータを消す
            </button>
          </div>
          <p class="muted text-sm" style="margin-top:12px;">
            消えるのは上に挙げたものだけです。読みやすさなどの表示設定は消えません。
          </p>
        </section>
      </div>

      {/* 操作の結果を出す場所。`alert()` だと作業が止まるので画面内に出す */}
      <p class="admin-toast" id="admin-toast" role="status" aria-live="polite" hidden></p>
    </div>
  </div>
</BaseLayout>

<script
  is:inline
  data-astro-rerun
  define:vars={{
    passHash,
    keys: {
      state: STATE_KEY,
      notices: NOTICES_KEY,
      admin: ADMIN_KEY,
      closed: GATE_CLOSED_KEY,
      images: IMAGES_KEY,
    },
    imgDef: DEFAULT_IMAGE_SOURCE,
    modeLabels,
    stored: STORED,
  }}
>
  (function () {
    var root = document.getElementById('admin-panel');
    var lock = document.getElementById('admin-lock');
    if (!lock || !root) return;
    // 同じページに留まったまま画面が入れ替わったとき、操作が二重に起きないようにする
    if (root.dataset.bound === '1') return;
    root.dataset.bound = '1';

    // キー名は src/lib/site-state.ts が正。ここには書かず define:vars で受け取る
    var STATE_KEY = keys.state;
    var NOTICES_KEY = keys.notices;
    var ADMIN_KEY = keys.admin;

    var $ = function (id) {
      return document.getElementById(id);
    };
    var read = function (key, fallback) {
      try {
        var raw = localStorage.getItem(key);
        return raw ? JSON.parse(raw) : fallback;
      } catch (e) {
        return fallback;
      }
    };
    var write = function (key, value) {
      try {
        localStorage.setItem(key, JSON.stringify(value));
        return true;
      } catch (e) {
        toast('この端末に保存できませんでした。ブラウザの設定で保存が禁止されているかもしれません。', true);
        return false;
      }
    };

    /* ---- 画面内のお知らせ（alert の代わり）--------------------------- */
    var toastEl = $('admin-toast');
    var toastTimer = null;
    function toast(msg, isError) {
      if (!toastEl) return;
      toastEl.textContent = msg;
      toastEl.classList.toggle('is-error', !!isError);
      toastEl.hidden = false;
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(function () {
        toastEl.hidden = true;
      }, 5000);
    }

    /* ---- タブ -------------------------------------------------------- */
    var tabs = Array.prototype.slice.call(document.querySelectorAll('.admin-tab'));
    var panes = Array.prototype.slice.call(document.querySelectorAll('.admin-pane'));
    function selectTab(id, focus) {
      tabs.forEach(function (t) {
        var on = t.dataset.tab === id;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      });
      panes.forEach(function (p) {
        p.hidden = p.dataset.pane !== id;
      });
    }
    var tablist = $('admin-tabs');
    if (tablist) {
      tablist.addEventListener('click', function (e) {
        var t = e.target.closest('.admin-tab');
        if (t) selectTab(t.dataset.tab, false);
      });
      // 左右の矢印キーでタブを移れるようにする（タブの作法）
      tablist.addEventListener('keydown', function (e) {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        var i = tabs.findIndex(function (t) {
          return t.getAttribute('aria-selected') === 'true';
        });
        if (i === -1) return;
        var next = e.key === 'ArrowRight' ? (i + 1) % tabs.length : (i - 1 + tabs.length) % tabs.length;
        e.preventDefault();
        selectTab(tabs[next].dataset.tab, true);
      });
    }

    /* ---- ロックの開け閉め ------------------------------------------- */
    function show(unlocked) {
      lock.hidden = unlocked;
      root.hidden = !unlocked;
      if (unlocked) {
        renderState();
        renderNotices();
        renderImages();
        renderStored();
      }
    }
    // ※ 最初の表示は**このスクリプトの末尾**で行う。ここで呼ぶと、
    //    まだ用意していない変数を render 側が読んで落ちる。

    var form = $('admin-form');
    var err = $('admin-error');
    function fail(msg) {
      err.textContent = msg;
      err.hidden = false;
    }
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var input = $('admin-pass');
      var value = input.value || '';
      // SHA-256 は Web Crypto（https と localhost で使える）。
      // 使えない環境では鍵を掛けない旨を出す（黙って素通しにしない）。
      if (!window.crypto || !window.crypto.subtle) {
        fail('この環境では合言葉を照合できません（安全な接続でのみ動作します）。');
        return;
      }
      window.crypto.subtle
        .digest('SHA-256', new TextEncoder().encode(value))
        .then(function (buf) {
          var hex = Array.prototype.map
            .call(new Uint8Array(buf), function (b) {
              return ('0' + b.toString(16)).slice(-2);
            })
            .join('');
          if (hex !== passHash) {
            fail('合言葉が違います。');
            input.select();
            return;
          }
          err.hidden = true;
          input.value = '';
          try {
            localStorage.setItem(ADMIN_KEY, '1');
          } catch (e2) {}
          show(true);
        })
        .catch(function () {
          // 照合そのものに失敗したときに無反応で終わらせない
          fail('合言葉を確認できませんでした。ページを開き直してお試しください。');
        });
    });

    $('admin-logout').addEventListener('click', function () {
      try {
        localStorage.removeItem(ADMIN_KEY);
      } catch (e) {}
      show(false);
    });

    /* ---- サイトの状態 ------------------------------------------------ */
    var current = read(STATE_KEY, { mode: 'normal', message: '', until: '' });
    function labelOfMode(v) {
      return modeLabels[v] || v;
    }
    function renderState() {
      var btns = document.querySelectorAll('#admin-modes .admin-mode');
      for (var i = 0; i < btns.length; i++) {
        btns[i].setAttribute('aria-pressed', String(btns[i].dataset.mode === current.mode));
      }
      $('admin-msg').value = current.message || '';
      $('admin-until').value = current.until || '';
      // いまの状態を上のバーにも出す（保存したかどうかが分かるように）
      var now = $('admin-now');
      if (now) now.textContent = 'いまこの端末は「' + labelOfMode(current.mode) + '」です';
    }
    $('admin-modes').addEventListener('click', function (e) {
      var btn = e.target.closest('.admin-mode');
      if (!btn) return;
      current.mode = btn.dataset.mode;
      renderState();
    });
    function saveState() {
      current.message = $('admin-msg').value.trim();
      current.until = $('admin-until').value.trim();
      if (!write(STATE_KEY, current)) return;
      try {
        sessionStorage.removeItem(keys.closed);
      } catch (e) {}
      renderState();
      renderStored();
      toast(
        current.mode === 'normal'
          ? '通常の状態にしました。'
          : 'この端末を「' + labelOfMode(current.mode) + '」にしました。ほかの方の画面は変わりません。',
      );
    }
    $('admin-save-state').addEventListener('click', saveState);
    $('admin-reset-state').addEventListener('click', function () {
      current = { mode: 'normal', message: '', until: '' };
      renderState();
      saveState();
    });

    /* ---- お知らせ ---------------------------------------------------- */
    function notices() {
      var list = read(NOTICES_KEY, []);
      return Array.isArray(list) ? list : [];
    }
    function renderNotices() {
      var host = $('notice-admin-list');
      var list = notices();
      host.textContent = '';
      if (list.length === 0) {
        var p = document.createElement('p');
        p.className = 'muted text-sm';
        p.textContent = 'まだありません。';
        host.appendChild(p);
        return;
      }
      list.forEach(function (n) {
        var row = document.createElement('div');
        row.className = 'admin-row';
        var txt = document.createElement('div');
        var strong = document.createElement('strong');
        strong.textContent = n.title || '(無題)';
        var small = document.createElement('span');
        small.className = 'muted text-sm';
        small.textContent = ' ' + (n.date || '日付なし') + ' / ' + (n.level || 'info');
        txt.appendChild(strong);
        txt.appendChild(small);
        var del = document.createElement('button');
        del.className = 'btn btn-ghost';
        del.type = 'button';
        del.textContent = '削除';
        del.addEventListener('click', function () {
          if (!confirm('「' + (n.title || '(無題)') + '」を削除します。よろしいですか。')) return;
          // ★ 並び順の番号ではなく **id** で消す。
          //   表示してから押すまでに中身が変わっていても、別のものを消さない。
          var next = notices().filter(function (x) {
            return x.id !== n.id;
          });
          if (write(NOTICES_KEY, next)) {
            renderNotices();
            renderStored();
            toast('削除しました。');
          }
        });
        row.appendChild(txt);
        row.appendChild(del);
        host.appendChild(row);
      });
    }

    /** 入力を1か所で取り出す（追加と書き出しで同じものを使う） */
    function noticeInput() {
      var title = $('notice-title').value.trim();
      var body = $('notice-body').value.trim();
      if (!title || !body) {
        toast('見出しと本文を入力してください。', true);
        return null;
      }
      return {
        title: title,
        body: body,
        // 日付が空のままでも使えるよう、今日を入れておく
        date: $('notice-date').value || new Date().toISOString().slice(0, 10),
        level: $('notice-level').value || 'info',
      };
    }

    $('notice-add').addEventListener('click', function () {
      var v = noticeInput();
      if (!v) return;
      var list = notices();
      list.unshift({
        id: 'local-' + Date.now(),
        date: v.date,
        level: v.level,
        title: v.title,
        body: v.body,
      });
      if (!write(NOTICES_KEY, list)) return;
      $('notice-title').value = '';
      $('notice-body').value = '';
      renderNotices();
      renderStored();
      toast('この端末に追加しました。お知らせ一覧の下部に出ます。');
    });

    // 全員に配る形（src/lib/notices.ts に貼れる形）で書き出す
    $('notice-copy').addEventListener('click', function () {
      var v = noticeInput();
      if (!v) return;
      // ★ 日付だけだと**同じ日に2件作ると id が衝突する**（id は URL になる）。
      //   時刻を足して一意にする。
      var d = new Date();
      var hhmm = ('0' + d.getHours()).slice(-2) + ('0' + d.getMinutes()).slice(-2);
      var id = 'notice-' + v.date.replace(/-/g, '') + '-' + hhmm;
      // 文字列は JSON.stringify で囲む（引用符・改行・バックスラッシュを自分で
      // 逃がすと、貼り付けたコードが壊れる。ここは人が書く場所ではない）
      var q = function (x) {
        return JSON.stringify(String(x));
      };
      var text =
        '  {\n' +
        '    id: ' + q(id) + ',\n' +
        '    date: ' + q(v.date) + ',\n' +
        '    title: ' + q(v.title) + ',\n' +
        '    body: [\n' +
        v.body
          .split(/\n{2,}/)
          .map(function (p) {
            return '      ' + q(p.replace(/\n/g, ' ')) + ',';
          })
          .join('\n') +
        "\n    ].join('\\n\\n'),\n" +
        '    level: ' + q(v.level) + ',\n' +
        '  },';
      copy(text, 'src/lib/notices.ts の NOTICES に貼り付けて公開し直すと、全員に見えるようになります。');
    });

    /** クリップボードへ。使えない環境では入力欄に出して手で写せるようにする */
    function copy(text, okMsg) {
      var fallback = function () {
        window.prompt('コピーしてお使いください', text);
      };
      if (!navigator.clipboard || !navigator.clipboard.writeText) {
        fallback();
        return;
      }
      navigator.clipboard
        .writeText(text)
        .then(function () {
          toast('コピーしました。' + (okMsg || ''));
        })
        .catch(fallback);
    }

    /* ---- キャラクターの画像 ------------------------------------------
       選んだ値は localStorage に入れ、**その場で `data-images` に反映**する。
       同じことを BaseLayout の起動スクリプトが描画前にやっているので、
       次に開いたページでも同じ状態になる。 */
    var imgNow = imgDef;
    try {
      var saved = localStorage.getItem(keys.images);
      if (saved) imgNow = saved;
    } catch (e) {}
    function renderImages() {
      var btns = document.querySelectorAll('#admin-images .admin-mode');
      for (var i = 0; i < btns.length; i++) {
        btns[i].setAttribute('aria-pressed', String(btns[i].dataset.img === imgNow));
      }
    }
    $('admin-images').addEventListener('click', function (e) {
      var btn = e.target.closest('.admin-mode');
      if (!btn) return;
      imgNow = btn.dataset.img;
      try {
        localStorage.setItem(keys.images, imgNow);
      } catch (e2) {}
      // 既定値のときは属性を書かない（起動スクリプトと同じ約束）
      if (imgNow === imgDef) document.documentElement.removeAttribute('data-images');
      else document.documentElement.setAttribute('data-images', imgNow);
      renderImages();
      renderStored();
      toast('画像の出どころを切り替えました。');
    });

    /* ---- この端末のデータ -------------------------------------------- */
    function renderStored() {
      var host = $('admin-stored');
      if (!host) return;
      host.textContent = '';
      stored.forEach(function (s) {
        var raw = null;
        try {
          raw = localStorage.getItem(s.key);
        } catch (e) {}
        var row = document.createElement('div');
        row.className = 'admin-row';
        var txt = document.createElement('div');
        var strong = document.createElement('strong');
        strong.textContent = s.label;
        var small = document.createElement('span');
        small.className = 'muted text-sm';
        small.textContent = ' ' + s.hint;
        txt.appendChild(strong);
        txt.appendChild(document.createElement('br'));
        txt.appendChild(small);
        var badge = document.createElement('span');
        badge.className = raw ? 'badge badge-accent' : 'badge';
        badge.textContent = raw ? '保存あり' : 'なし';
        row.appendChild(txt);
        row.appendChild(badge);
        host.appendChild(row);
      });
    }

    $('admin-export').addEventListener('click', function () {
      var out = {};
      stored.forEach(function (s) {
        try {
          var raw = localStorage.getItem(s.key);
          if (raw !== null) out[s.key] = raw;
        } catch (e) {}
      });
      copy(JSON.stringify(out, null, 2), '');
    });

    $('admin-clear').addEventListener('click', function () {
      if (!confirm('この端末に保存した管理のデータ（状態・お知らせ・画像の設定・ロックの印）を消します。よろしいですか。')) {
        return;
      }
      stored.forEach(function (s) {
        try {
          localStorage.removeItem(s.key);
        } catch (e) {}
      });
      current = { mode: 'normal', message: '', until: '' };
      imgNow = imgDef;
      document.documentElement.removeAttribute('data-images');
      renderState();
      renderNotices();
      renderImages();
      renderStored();
      toast('消しました。ロックも掛かります。');
      show(false);
    });

    /* ---- 最初の表示（すべての変数を用意したあとで） ------------------- */
    try {
      show(localStorage.getItem(ADMIN_KEY) === '1');
    } catch (e) {
      show(false);
    }
  })();
</script>
