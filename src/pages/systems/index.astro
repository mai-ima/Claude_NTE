---
import EntityList from '../../components/EntityList.astro';
import { sectionByCollection } from '../../lib/nav';
const s = sectionByCollection('systems')!;
---
<EntityList
  collection="systems"
  title="ゲームシステム"
  eyebrow="システム"
  lead="戦闘・属性相性（エスパーサイクル）・ガチャ・スタミナなど、NTEの仕組みを解説。"
  icon={s.icon}
  groupField="category"
  groupOrder={['戦闘', 'エスパーサイクル', 'ガチャ', 'スタミナ', '育成・進行', 'エンドコンテンツ']}
/>
