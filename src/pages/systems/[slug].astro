---
import EntityDetail from '../../components/EntityDetail.astro';
import { detailPaths, renderEntry, baseDetailProps } from '../../lib/detail';
import type { Row } from '../../components/EntityDetail.astro';

export async function getStaticPaths() {
  return detailPaths('systems');
}
const { entry, prev, next } = Astro.props;
const { Content, headings } = await renderEntry(entry);
const d = entry.data as any;
const rows: Row[] = [];
if (d.category) rows.push({ k: '分類', v: d.category });
---
<EntityDetail
  {...baseDetailProps('systems', entry, prev, next)}
  rows={rows}
  headings={headings}
>
  <Content />
</EntityDetail>
