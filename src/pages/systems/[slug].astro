---
import { render } from 'astro:content';
import EntityDetail from '../../components/EntityDetail.astro';
import { sectionByCollection } from '../../lib/nav';
import { titleOf, hrefOf, publishedEntries } from '../../lib/content';
import type { Row } from '../../components/EntityDetail.astro';

export async function getStaticPaths() {
  const sorted = await publishedEntries('systems');
  return sorted.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: sorted[i - 1] ?? null, next: sorted[i + 1] ?? null },
  }));
}
const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry as any);
const d = entry.data as any;
const section = sectionByCollection('systems')!;
const rows: Row[] = [];
if (d.category) rows.push({ k: '分類', v: d.category });
---
<EntityDetail
  collection="systems"
  currentId={entry.id}
  sectionLabel={section.label}
  sectionHref={section.href}
  sectionIcon={section.icon}
  title={titleOf(entry)}
  lead={d.description}
  rows={rows}
  status={d.status}
  updated={d.updated}
  tags={d.tags}
  sources={d.sources}
  headings={headings}
  prev={prev ? { href: hrefOf('systems', prev.id), title: titleOf(prev) } : null}
  next={next ? { href: hrefOf('systems', next.id), title: titleOf(next) } : null}
  editPath={(entry as any).filePath}
>
  <Content />
</EntityDetail>
