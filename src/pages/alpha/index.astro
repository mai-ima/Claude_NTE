---
import { Icon } from 'astro-icon/components';
import AlphaLayout from '../../layouts/AlphaLayout.astro';
import { withBase } from '../../lib/path';
import { wiki } from '../../lib/wikis';
import { loadNavSections, recentEntries } from '../../lib/content';

const w = wiki('alpha');
const sections = await loadNavSections(w.sections);
const countOf = (c: string) => sections.find((s) => s.collection === c)?.items.length ?? 0;
const total = sections.reduce((sum, s) => sum + s.items.length, 0);
const recent = await recentEntries(4, w.sections);
---

<AlphaLayout title="ホーム">
  <header>
    <p class="a-eyebrow">αテスト（仮）wiki</p>
    <h1 class="a-h1">別ゲームの wiki を、別のUIで。</h1>
    <p class="a-lead">
      このwikiは、<strong>1つのサイトに複数ゲームのwikiを並置できるか</strong>を確かめるためのサンプルです。
      記事データも画面のつくりも <a href={withBase('/')}>NTE 完全攻略wiki</a> とは切り離してあり、
      こちらはスマホでの読みやすさを優先した専用UIで動いています。
    </p>
  </header>

  <div class="a-note">
    <Icon name="lucide:flask-conical" />
    <div>
      <strong>「αテスト（仮）」は実在のゲームではありません</strong>
      掲載している {total} 本の記事はすべて構造確認用のダミーデータです。
    </div>
  </div>

  <div class="a-grid a-grid-2">
    {
      w.sections.map((s) => (
        <a class="a-card" href={withBase(s.href)}>
          <span class="a-card-title">{s.label}</span>
          <span class="a-card-desc">{s.blurb}</span>
          <span class="a-badges">
            <span class="a-badge a-badge-accent">{countOf(s.collection)} 記事</span>
          </span>
        </a>
      ))
    }
  </div>

  {
    recent.length > 0 && (
      <section style="margin-top:28px;">
        <h2 class="a-card-title" style="font-size:1.05rem;">最近更新した記事</h2>
        <div class="a-grid">
          {recent.map((e) => (
            <a class="a-card" href={e.href}>
              <span class="a-card-title">{e.title}</span>
              <span class="a-badges">
                <span class="a-badge">{e.sectionLabel}</span>
                <span class="a-badge">
                  {e.updated.toLocaleDateString('ja-JP', { timeZone: 'Asia/Tokyo' })}
                </span>
              </span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <section style="margin-top:28px;">
    <h2 class="a-card-title" style="font-size:1.05rem;">この wiki の作り</h2>
    <div class="a-grid">
      <a class="a-card" href={withBase('/alpha/guides/about/')}>
        <span class="a-card-title">NTE 側と何が分かれているか</span>
        <span class="a-card-desc">
          記事データ（コレクション）・URL・ナビ・用語の自動リンク辞書、そして画面のスタイルまで独立しています。
        </span>
      </a>
      <a class="a-card" href={withBase('/')}>
        <span class="a-card-title">NTE 完全攻略wiki へ</span>
        <span class="a-card-desc">
          情報量を重視した従来のUI。上部の切替ボタンからいつでも行き来できます。
        </span>
      </a>
    </div>
  </section>
</AlphaLayout>
