---
import EntityDetail from '../../../components/EntityDetail.astro';
import { detailPaths, renderEntry, baseDetailProps } from '../../../lib/detail';
import type { Row } from '../../../components/EntityDetail.astro';

export async function getStaticPaths() {
  return detailPaths('alphaGuides', { relatedBy: 'category' });
}
const { entry, prev, next, related } = Astro.props;
const { Content, headings } = await renderEntry(entry);
const d = entry.data as any;

const rows: Row[] = [{ k: '分類', v: d.category }];
---
<EntityDetail
  {...baseDetailProps('alphaGuides', entry, prev, next)}
  pills={[{ kind: 'plain', value: d.category }]}
  rows={rows}
  headings={headings}
  editPath={(entry as any).filePath}
  related={related}
  relatedLabel={`${d.category} の記事`}
>
  <Content />
</EntityDetail>
