---
import AlphaArticle from '../../../components/alpha/AlphaArticle.astro';
import { detailPaths, renderEntry } from '../../../lib/detail';
import { titleOf } from '../../../lib/content';

export async function getStaticPaths() {
  return detailPaths('alphaGuides');
}
const { entry, prev, next } = Astro.props;
const { Content, headings } = await renderEntry(entry);
const d = entry.data as any;

const badges = [d.category, d.reading ? `よみ: ${d.reading}` : null, d.en].filter(Boolean) as string[];
---
<AlphaArticle
  collection="alphaGuides"
  title={titleOf(entry)}
  description={d.description}
  headings={headings}
  badges={badges}
  status={d.status}
  updated={d.updated}
  sources={d.sources}
  prev={prev ? { href: `/alpha/guides/${prev.id}/`, title: titleOf(prev) } : null}
  next={next ? { href: `/alpha/guides/${next.id}/`, title: titleOf(next) } : null}
>
  <Content />
</AlphaArticle>
