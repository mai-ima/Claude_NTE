---
import EntityDetail from '../../components/EntityDetail.astro';
import { detailPaths, renderEntry, baseDetailProps } from '../../lib/detail';
import type { Row, Pill } from '../../components/EntityDetail.astro';

export async function getStaticPaths() {
  return detailPaths('arcs', { relatedBy: 'rarity' });
}
const { entry, prev, next, related } = Astro.props;
const { Content, headings } = await renderEntry(entry);
const d = entry.data as any;

const rows: Row[] = [];
rows.push({ k: 'レア度', v: `${d.rarity}ランク` });
if (d.form) rows.push({ k: '物質形態', v: d.form });
if (d.acquisition) rows.push({ k: '入手方法', v: d.acquisition });
if (d.free !== undefined) rows.push({ k: '無課金入手', v: d.free ? '可' : '—' });
if (d.recommendedFor) rows.push({ k: 'おすすめ', v: d.recommendedFor });

const pills: Pill[] = [{ kind: 'rarity', value: d.rarity }];
---
<EntityDetail
  {...baseDetailProps('arcs', entry, prev, next)}
  pills={pills}
  rows={rows}
  headings={headings}
  related={related}
  relatedLabel={`${d.rarity}ランクの弧盤`}
>
  <Content />
</EntityDetail>
