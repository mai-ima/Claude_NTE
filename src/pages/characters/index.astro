---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import Avatar from '../../components/Avatar.astro';
import { ELEMENT_META, ROLE_META, elementMeta, roleMeta } from '../../lib/nav';
import { publishedEntries, titleOf, enNameOf, hrefOf } from '../../lib/content';

const entries = await publishedEntries('characters');
// 実装済み（プレイアブル）と実装予定（未実装・告知済み）を分離
const implementedEntries = entries.filter((c: any) => c.data.implemented !== false);
const upcoming = entries.filter((c: any) => c.data.implemented === false);
// レア度(S→A) → 属性 → 名前 で整列
const RAR = { S: 0, A: 1 } as Record<string, number>;
const list = [...implementedEntries].sort(
  (a: any, b: any) =>
    (RAR[a.data.rarity] ?? 9) - (RAR[b.data.rarity] ?? 9) ||
    titleOf(a).localeCompare(titleOf(b), 'ja'),
);

// 並び替え用の順位（設定「一覧の並び順」が CSS の order で拾う。EntityList と同じ仕組み）
const updatedMs = (e: any) => (e.data.updated instanceof Date ? e.data.updated.getTime() : 0);
const ordUpdated = new Map(
  [...list].sort((a, b) => updatedMs(b) - updatedMs(a)).map((e, i) => [e.id, i]),
);
const ordName = new Map(
  [...list].sort((a, b) => titleOf(a).localeCompare(titleOf(b), 'ja')).map((e, i) => [e.id, i]),
);
const ordVars = (e: any) =>
  `--ord-updated:${ordUpdated.get(e.id) ?? 0};--ord-name:${ordName.get(e.id) ?? 0}`;

const elements = Object.keys(ELEMENT_META);
const roles = Object.keys(ROLE_META);
const rarities = ['S', 'A'];

// 分布サマリー
const byEl = elements.map((e) => ({ e, n: list.filter((c: any) => c.data.element === e).length }));
const byRole = roles.map((r) => ({ r, n: list.filter((c: any) => c.data.role === r).length }));
const maxEl = Math.max(1, ...byEl.map((x) => x.n));
const sCount = list.filter((c: any) => c.data.rarity === 'S').length;
const aCount = list.filter((c: any) => c.data.rarity === 'A').length;
---

<BaseLayout title="キャラクター一覧">
  <div class="layout has-sidebar">
    <Sidebar currentCollection="characters" />
    <div class="content">
      <section class="page-head">
        <p class="eyebrow">キャラクター</p>
        <h1>エスパー一覧</h1>
        <p class="lead">
          プレイアブルキャラ（エスパー）の属性・ロール・性能。フィルタで絞り込めます（{list.length}体）。
        </p>
      </section>

      <div class="card card-pad" style="margin-bottom:20px;">
        <div class="row row-between" style="margin-bottom:10px;">
          <strong>属性・ロール分布</strong>
          <span class="cluster">
            <span class="badge badge-rarity-S">S {sCount}</span>
            <span class="badge badge-rarity-A">A {aCount}</span>
          </span>
        </div>
        <div class="dist-grid">
          {
            byEl.map((x) => (
              <div class="dist-row">
                <span class="el-badge" style={`--el:${elementMeta(x.e).hue};min-width:54px;justify-content:center;`}>
                  {elementMeta(x.e).label}
                </span>
                <div class="dist-bar">
                  <span style={`width:${(x.n / maxEl) * 100}%;background:${elementMeta(x.e).hue};`} />
                </div>
                <span class="muted text-sm" style="width:1.5em;text-align:right;">{x.n}</span>
              </div>
            ))
          }
        </div>
        <div class="cluster" style="margin-top:10px;">
          {
            byRole.map((x) => (
              <span class="badge">
                <Icon name={`lucide:${roleMeta(x.r).icon}`} style="width:13px;height:13px;" />
                {roleMeta(x.r).label.replace(/\s*\(.*\)/, '')} {x.n}
              </span>
            ))
          }
        </div>
      </div>

      <div class="filterbar" id="char-filters" role="group" aria-label="フィルタ">
        <button class="chip is-on" data-filter-all aria-pressed="true">
          <Icon name="lucide:list" style="width:15px;height:15px;" />すべて
        </button>
        {
          rarities.map((r) => (
            <button class="chip" data-rarity={r} aria-pressed="false">
              {r}-Class
            </button>
          ))
        }
        {
          elements.map((e) => (
            <button class="chip" data-element={e} aria-pressed="false">
              <span class="el-dot" style={`--el:${elementMeta(e).hue}`} />
              {elementMeta(e).label}
            </button>
          ))
        }
        {
          roles.map((r) => (
            <button class="chip" data-role={r} aria-pressed="false">
              <Icon name={`lucide:${roleMeta(r).icon}`} style="width:14px;height:14px;" />
              {roleMeta(r).label.replace(/\s*\(.*\)/, '')}
            </button>
          ))
        }
      </div>

      <div class="grid grid-cards" id="char-grid">
        {
          list.map((entry: any) => {
            const d = entry.data;
            const em = elementMeta(d.element);
            return (
              <a
                class="card card-pad card-link char-card"
                href={hrefOf('characters', entry.id)}
                style={`--el:${em.hue};${ordVars(entry)}`}
                data-rarity={d.rarity}
                data-element={d.element}
                data-role={d.role}
              >
                <div class="row" style="gap:10px;align-items:center;">
                  <Avatar name={enNameOf(entry)} element={d.element} rarity={d.rarity} size={46} />
                  <div style="flex:1;min-width:0;">
                    <div class="row" style="gap:6px;align-items:center;">
                      <span style="font-weight:800;font-size:1.02rem;">{titleOf(entry)}</span>
                      {d.tier && <span class:list={['tier-badge', `tier-${d.tier}`]}>{d.tier}</span>}
                    </div>
                    <div class="muted" style="font-size:0.72rem;">{enNameOf(entry)}</div>
                  </div>
                </div>
                <div class="cluster" style="margin-top:10px;">
                  <span class="el-badge" style={`--el:${em.hue}`}>
                    <span class="el-dot" />
                    {em.label}
                  </span>
                  <span class="badge">
                    <Icon name={`lucide:${roleMeta(d.role).icon}`} style="width:13px;height:13px;" />
                    {roleMeta(d.role).label.replace(/\s*\(.*\)/, '')}
                  </span>
                </div>
                {d.description && (
                  <p class="muted text-sm" style="margin-top:10px;">
                    {d.description}
                  </p>
                )}
                {(d.weapon || d.cv) && (
                  <div class="char-meta">
                    {d.weapon && (
                      <span><Icon name="lucide:sword" /> {d.weapon.replace('弧盤: ', '')}</span>
                    )}
                    {d.cv && (
                      <span><Icon name="lucide:mic" /> {d.cv}</span>
                    )}
                  </div>
                )}
              </a>
            );
          })
        }
      </div>

      <p class="empty" id="char-empty" hidden>条件に合うキャラがいません。</p>

      {
        upcoming.length > 0 && (
          <section style="margin-top:32px;">
            <div class="row" style="gap:8px;align-items:center;margin-bottom:6px;">
              <Icon name="lucide:wrench" style="width:18px;height:18px;color:var(--accent);" />
              <h2 style="margin:0;">実装予定（未実装）</h2>
            </div>
            <p class="muted text-sm" style="margin-bottom:12px;">
              公式で告知されている実装予定キャラ。属性・性能は未確定（要確認）です。
            </p>
            <div class="grid grid-cards">
              {upcoming.map((entry: any) => (
                <a class="card card-pad card-link" href={hrefOf('characters', entry.id)}>
                  <div class="row" style="gap:6px;align-items:center;">
                    <span style="font-weight:800;font-size:1.02rem;">{titleOf(entry)}</span>
                    <span class="badge badge-accent">実装予定</span>
                  </div>
                  <div class="muted" style="font-size:0.72rem;">{enNameOf(entry)}</div>
                  {entry.data.description && (
                    <p class="muted text-sm" style="margin-top:8px;">{entry.data.description}</p>
                  )}
                  {entry.data.version && (
                    <div class="char-meta">
                      <span><Icon name="lucide:calendar-clock" /> {entry.data.version}</span>
                    </div>
                  )}
                </a>
              ))}
            </div>
          </section>
        )
      }
    </div>
  </div>
</BaseLayout>

<script>
  // キャラ一覧のクライアントフィルタ（属性/ロール/レア度の AND 絞り込み）。
  // View Transitions では本文が swap されるため astro:page-load ごとに再初期化する。
  function initCharFilter() {
    const bar = document.getElementById('char-filters');
    const grid = document.getElementById('char-grid');
    const empty = document.getElementById('char-empty');
    if (!bar || !grid) return;
    // 同一バー要素への二重バインド防止（堅牢化）。遷移ごとにバーは作り直されるため通常は不要だが安全策。
    if (bar.dataset.filterBound) return;
    bar.dataset.filterBound = '1';
    const active = { rarity: new Set<string>(), element: new Set<string>(), role: new Set<string>() };

    function apply() {
      let shown = 0;
      grid!.querySelectorAll<HTMLElement>('.char-card').forEach((card) => {
        const okR = active.rarity.size === 0 || active.rarity.has(card.dataset.rarity || '');
        const okE = active.element.size === 0 || active.element.has(card.dataset.element || '');
        const okRole = active.role.size === 0 || active.role.has(card.dataset.role || '');
        const show = okR && okE && okRole;
        card.style.display = show ? '' : 'none';
        if (show) shown++;
      });
      if (empty) (empty as HTMLElement).hidden = shown !== 0;
      const noFilter = !active.rarity.size && !active.element.size && !active.role.size;
      bar!.querySelector('[data-filter-all]')?.classList.toggle('is-on', noFilter);
      bar!.querySelector('[data-filter-all]')?.setAttribute('aria-pressed', String(noFilter));
    }

    bar.addEventListener('click', (ev) => {
      const btn = (ev.target as HTMLElement).closest('button');
      if (!btn) return;
      if (btn.hasAttribute('data-filter-all')) {
        active.rarity.clear();
        active.element.clear();
        active.role.clear();
        bar.querySelectorAll('.chip').forEach((c) => {
          c.classList.remove('is-on');
          c.setAttribute('aria-pressed', 'false');
        });
        apply();
        return;
      }
      const map: Record<string, Set<string>> = {
        rarity: active.rarity,
        element: active.element,
        role: active.role,
      };
      for (const key of ['rarity', 'element', 'role'] as const) {
        const val = btn.dataset[key];
        if (val) {
          if (map[key].has(val)) map[key].delete(val);
          else map[key].add(val);
          const on = map[key].has(val);
          btn.classList.toggle('is-on', on);
          btn.setAttribute('aria-pressed', String(on));
        }
      }
      apply();
    });
  }
  document.addEventListener('astro:page-load', initCharFilter);
</script>
