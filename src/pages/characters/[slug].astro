---
import { render } from 'astro:content';
import EntityDetail from '../../components/EntityDetail.astro';
import { sectionByCollection, elementMeta, roleMeta } from '../../lib/nav';
import { titleOf, enNameOf, hrefOf, publishedEntries } from '../../lib/content';
import type { Row, Pill } from '../../components/EntityDetail.astro';

export async function getStaticPaths() {
  const sorted = await publishedEntries('characters');
  return sorted.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: sorted[i - 1] ?? null, next: sorted[i + 1] ?? null },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry as any);
const d = entry.data as any;
const section = sectionByCollection('characters')!;

const pills: Pill[] = [
  { kind: 'rarity', value: d.rarity },
  { kind: 'element', value: d.element },
  { kind: 'role', value: d.role },
];
const em = elementMeta(d.element);
const rows: Row[] = [
  { k: '英語名', v: enNameOf(entry) },
  { k: 'レア度', v: `${d.rarity}-Class` },
  { k: '属性', v: `${em.label}（${em.en}）` },
  { k: 'ロール', v: roleMeta(d.role).label },
];
if (d.weapon) rows.push({ k: '武器(Arc)', v: d.weapon });
if (d.faction) rows.push({ k: '所属', v: d.faction });
if (d.version) rows.push({ k: '実装', v: d.version });
if (d.tier) rows.push({ k: 'ティア(参考)', v: d.tier });
---

<EntityDetail
  collection="characters"
  currentId={entry.id}
  sectionLabel={section.label}
  sectionHref={section.href}
  sectionIcon={section.icon}
  title={titleOf(entry)}
  lead={d.description}
  pills={pills}
  rows={rows}
  status={d.status}
  updated={d.updated}
  tags={d.tags}
  sources={d.sources}
  headings={headings}
  prev={prev ? { href: hrefOf('characters', prev.id), title: titleOf(prev) } : null}
  next={next ? { href: hrefOf('characters', next.id), title: titleOf(next) } : null}
  heroAvatar={{ name: enNameOf(entry), element: d.element, rarity: d.rarity }}
>
  <Content />
</EntityDetail>
