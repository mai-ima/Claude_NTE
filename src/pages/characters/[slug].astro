---
import EntityDetail from '../../components/EntityDetail.astro';
import EsperRing from '../../components/EsperRing.astro';
import { elementMeta, roleMeta, reactionsFor } from '../../lib/nav';
import { enNameOf } from '../../lib/content';
import { detailPaths, renderEntry, baseDetailProps } from '../../lib/detail';
import type { Row, Pill } from '../../components/EntityDetail.astro';

export async function getStaticPaths() {
  return detailPaths('characters', { relatedBy: 'element' });
}

const { entry, prev, next, related } = Astro.props;
const { Content, headings } = await renderEntry(entry);
const d = entry.data as any;
// 未実装（告知済み）キャラは属性・レア度等が未確定なため、存在する項目だけ表示する。
const hasEl = Boolean(d.element);

const pills: Pill[] = [];
if (d.implemented === false) pills.push({ kind: 'plain', value: '実装予定' });
if (d.rarity) pills.push({ kind: 'rarity', value: d.rarity });
if (d.element) pills.push({ kind: 'element', value: d.element });
if (d.role) pills.push({ kind: 'role', value: d.role });
if (d.tier) pills.push({ kind: 'tier', value: d.tier });

const em = hasEl ? elementMeta(d.element) : null;
const rows: Row[] = [{ k: '英語名', v: enNameOf(entry) }];
if (d.implemented === false) rows.push({ k: '状態', v: '実装予定（未実装）' });
if (d.rarity) rows.push({ k: 'レア度', v: `${d.rarity}-Class` });
if (em) rows.push({ k: '属性', v: `${em.label}（${em.en}）` });
if (d.role) rows.push({ k: 'ロール', v: roleMeta(d.role).label });
if (d.weapon) rows.push({ k: '武器(弧盤)', v: d.weapon });
if (d.cv) rows.push({ k: '声優', v: d.cv });
if (d.birthday) rows.push({ k: '誕生日', v: d.birthday });
if (d.faction && d.faction !== '—') rows.push({ k: '所属', v: d.faction });
if (d.version) rows.push({ k: '実装', v: d.version });
if (d.tier) rows.push({ k: 'ティア(参考)', v: d.tier });
---

<EntityDetail
  {...baseDetailProps('characters', entry, prev, next)}
  pills={pills}
  rows={rows}
  headings={headings}
  heroAvatar={hasEl ? { name: enNameOf(entry), element: d.element, rarity: d.rarity ?? '?' } : undefined}
  related={related}
  relatedLabel={em ? `${em.label}属性のキャラ` : '関連キャラ'}
>
  <Content />
  {
    hasEl && (
      <div slot="aside" class="card card-pad">
        <p style="font-weight:700;margin-bottom:4px;">異能連環での相性</p>
        <p class="muted text-sm" style="margin-bottom:8px;">
          {em!.label}（{em!.en}）と隣接属性の反応
        </p>
        <EsperRing highlight={d.element} size={200} />
        <ul class="text-sm" style="margin-top:8px;padding-left:1.1em;">
          {reactionsFor(d.element).map((rx) => (
            <li>
              {elementMeta(rx.partner).label} とで <strong>{rx.name}</strong>（{rx.ja}）
            </li>
          ))}
        </ul>
      </div>
    )
  }
</EntityDetail>
