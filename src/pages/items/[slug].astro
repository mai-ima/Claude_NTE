---
import EntityDetail from '../../components/EntityDetail.astro';
import { detailPaths, renderEntry, baseDetailProps } from '../../lib/detail';
import type { Row } from '../../components/EntityDetail.astro';

const TYPE_JA: Record<string, string> = {
  currency: '通貨・ダイス', material: '育成素材', consumable: '消費アイテム', gear: '装備',
};

export async function getStaticPaths() {
  return detailPaths('items', { relatedBy: 'type' });
}
const { entry, prev, next, related } = Astro.props;
const { Content, headings } = await renderEntry(entry);
const d = entry.data as any;
const rows: Row[] = [{ k: '種別', v: TYPE_JA[d.type] ?? d.type }];
if (d.usedFor) rows.push({ k: '用途', v: d.usedFor });
---
<EntityDetail
  {...baseDetailProps('items', entry, prev, next)}
  rows={rows}
  headings={headings}
  related={related}
  relatedLabel={`${TYPE_JA[d.type] ?? d.type}の他のアイテム`}
>
  <Content />
</EntityDetail>
