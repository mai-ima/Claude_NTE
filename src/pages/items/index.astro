---
import EntityList from '../../components/EntityList.astro';
import { sectionByCollection } from '../../lib/nav';
const s = sectionByCollection('items')!;
---
<EntityList
  collection="items"
  title="アイテム・通貨"
  eyebrow="アイテム"
  lead="通貨・ダイス・育成素材・消費アイテムと、その入手と用途。"
  icon={s.icon}
  groupField="type"
  groupOrder={['currency', 'material', 'consumable', 'gear']}
  groupLabels={{ currency: '通貨・ダイス', material: '育成素材', consumable: '消費アイテム', gear: '装備（ギア）' }}
  filterField="type"
  filterLabels={{ currency: '通貨', material: '育成素材', consumable: '消費', gear: 'ギア' }}
/>
