---
import { getCollection } from "astro:content";
import EndfieldList from "../../../components/endfield/EndfieldList.astro";

// 下書き（draft: true）はビルドから除外する
const entries = (await getCollection("endfieldAreas")).filter((e) => !e.data.draft);
---

<EndfieldList collection="endfieldAreas" entries={entries} eyebrow="AREAS" />
