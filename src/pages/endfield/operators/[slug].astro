---
import EndfieldArticle from "../../../components/endfield/EndfieldArticle.astro";
import { detailPaths, renderEntry } from "../../../lib/detail";
import { titleOf } from "../../../lib/content";
import { findLocalImage } from "../../../lib/asset";
import { efClassKey, efElementKey } from "../../../lib/endfield";

export async function getStaticPaths() {
  return detailPaths("endfieldOperators");
}
const { entry, prev, next } = Astro.props;
const { Content, headings } = await renderEntry(entry);
const d = entry.data as Record<string, any>;

// 冒頭の要点。値があるものだけを拾う（空行を出さない）
const rows = [
  ["レア度", d.rarity],
  ["職業", d.class],
  ["属性", d.element],
  ["武器種", d.weaponType ?? d.type],
  ["部位", d.slot],
  ["区分", d.category],
  ["入手", d.acquisition],
  ["用途", d.usedFor],
  ["実装", d.version],
  ["CV", d.cv],
].filter(([, v]) => v).map(([label, value]) => ({ label, value: String(value) }));

const badges = [d.en, d.reading ? `よみ: ${d.reading}` : null].filter(Boolean) as string[];

/* 公式サイトから同梱した絵。記事では**全身の立ち絵**（illust）を出し、
   無ければ顔のアップ（operators）へ落ちる。
   姿が2つあるものは `<id>-2.webp` も置いてある（管理人）。
   置いていないものは絵なしで、今までどおりの見た目になる。 */
const pic = (id: string) =>
  findLocalImage("official/endfield/illust", id) ??
  findLocalImage("official/endfield/operators", id);
const images = [pic(entry.id), pic(`${entry.id}-2`)].filter(Boolean) as string[];
/* 絵に重ねる職業・属性のアイコン。日本語の表記から公式のキーへ引き直す */
const ck = efClassKey(d.class);
const ek = efElementKey(d.element);
const icons = [
  ck ? `/images/official/endfield/classes/${ck}.webp` : null,
  ek ? `/images/official/endfield/elements/${ek}.webp` : null,
].filter(Boolean) as string[];
---

<EndfieldArticle
  collection="endfieldOperators"
  title={titleOf(entry)}
  description={d.description}
  headings={headings}
  rows={rows}
  badges={badges}
  status={d.status}
  updated={d.updated}
  checked={d.checked}
  sources={d.sources}
  images={images}
  icons={icons}
  prev={prev ? { href: `/endfield/operators/${prev.id}/`, title: titleOf(prev) } : null}
  next={next ? { href: `/endfield/operators/${next.id}/`, title: titleOf(next) } : null}
>
  <Content />
</EndfieldArticle>
