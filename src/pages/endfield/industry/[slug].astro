---
import EndfieldArticle from "../../../components/endfield/EndfieldArticle.astro";
import { detailPaths, renderEntry } from "../../../lib/detail";
import { titleOf } from "../../../lib/content";

export async function getStaticPaths() {
  return detailPaths("endfieldIndustry");
}
const { entry, prev, next } = Astro.props;
const { Content, headings } = await renderEntry(entry);
const d = entry.data as Record<string, any>;

// 冒頭の要点。値があるものだけを拾う（空行を出さない）
const rows = [
  ["区分", d.category],
  ["解放", d.unlock],
  ["入手", d.acquisition],
].filter(([, v]) => v).map(([label, value]) => ({ label, value: String(value) }));

const badges = [d.en, d.reading ? `よみ: ${d.reading}` : null].filter(Boolean) as string[];
---

<EndfieldArticle
  collection="endfieldIndustry"
  entryId={entry.id}
  title={titleOf(entry)}
  description={d.description}
  headings={headings}
  rows={rows}
  badges={badges}
  status={d.status}
  updated={d.updated}
  checked={d.checked}
  sources={d.sources}
  prev={prev ? { href: `/endfield/industry/${prev.id}/`, title: titleOf(prev) } : null}
  next={next ? { href: `/endfield/industry/${next.id}/`, title: titleOf(next) } : null}
>
  <Content />
</EndfieldArticle>
