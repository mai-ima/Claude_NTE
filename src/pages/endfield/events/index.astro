---
import { getCollection } from "astro:content";
import EndfieldList from "../../../components/endfield/EndfieldList.astro";

// 下書き（draft: true）はビルドから除外する
const entries = (await getCollection("endfieldEvents")).filter((e) => !e.data.draft);
---

<EndfieldList collection="endfieldEvents" entries={entries} eyebrow="EVENTS" />
