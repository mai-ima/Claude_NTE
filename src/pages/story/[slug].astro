---
import EntityDetail from '../../components/EntityDetail.astro';
import { detailPaths, renderEntry, baseDetailProps } from '../../lib/detail';
import type { Row } from '../../components/EntityDetail.astro';

export async function getStaticPaths() {
  return detailPaths('story');
}
const { entry, prev, next } = Astro.props;
const { Content, headings } = await renderEntry(entry);
const d = entry.data as any;
const rows: Row[] = [];
if (d.arc) rows.push({ k: '章', v: d.arc });
---
<EntityDetail
  {...baseDetailProps('story', entry, prev, next)}
  rows={rows}
  headings={headings}
  spoilerNote={d.spoiler}
>
  <Content />
</EntityDetail>
