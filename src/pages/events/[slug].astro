---
import EntityDetail from '../../components/EntityDetail.astro';
import { detailPaths, renderEntry, baseDetailProps } from '../../lib/detail';
import type { Row, Pill } from '../../components/EntityDetail.astro';

export async function getStaticPaths() {
  return detailPaths('events', { relatedBy: 'kind' });
}
const { entry, prev, next, related } = Astro.props;
const { Content, headings } = await renderEntry(entry);
const d = entry.data as any;

const KIND_LABEL: Record<string, string> = {
  banner: 'ピックアップガチャ',
  'weapon-banner': '武器（弧盤）ガチャ',
  event: '期間限定イベント',
};
const fmt = (x?: Date) =>
  x ? x.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Tokyo' }) : '—';

const rows: Row[] = [];
rows.push({ k: '種別', v: KIND_LABEL[d.kind] ?? d.kind });
if (d.version) rows.push({ k: 'バージョン', v: d.version });
if (d.start || d.end) rows.push({ k: '開催期間', v: `${fmt(d.start)} 〜 ${d.end ? fmt(d.end) : '未定'}` });
if (d.featured?.length) rows.push({ k: '注目', v: d.featured.join('・') });

const pills: Pill[] = [{ kind: 'plain', value: KIND_LABEL[d.kind] ?? d.kind }];
---
<EntityDetail
  {...baseDetailProps('events', entry, prev, next)}
  pills={pills}
  rows={rows}
  headings={headings}
  related={related}
  relatedLabel={`${KIND_LABEL[d.kind] ?? d.kind}の他のイベント`}
>
  <Content />
</EntityDetail>
