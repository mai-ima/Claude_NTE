---
/** 鳴潮 攻略wiki のトップ（準備中）。中身が無いことを隠さずに書く。 */
import { Icon } from 'astro-icon/components';
import WuwaLayout from '../../layouts/WuwaLayout.astro';
import { withBase } from '../../lib/path';
import { wiki } from '../../lib/wikis';

const w = wiki('wuwa');
---

<WuwaLayout>
  <article class="ww-card">
    <p class="ww-eyebrow">Wuthering Waves</p>
    <h1 class="ww-title">鳴潮 攻略wiki</h1>
    {/* 公式が使っていた下向き三角（clip-path）。区切りの目印として置く */}
    <p class="ww-caret" aria-hidden="true"></p>

    <p class="ww-lead">
      この wiki は<strong>準備中</strong>です。まだ記事はありません。
    </p>

    <div class="ww-note">
      <p style="margin:0 0 8px;">
        <strong>いつ公開するかは決まっていません。</strong>
        できていないことを「近日公開」と書くのは正確ではないので、
        分かった時点でこのページを書き換えます。
      </p>
      <p style="margin:0;">最新の情報や正確な仕様は、公式サイトでご確認ください。</p>
    </div>

    <div class="ww-actions">
      <a class="ww-btn is-primary" href={w.officialUrl} target="_blank" rel="noopener noreferrer">
        公式サイトを開く
        <Icon name="lucide:external-link" />
      </a>
      {/*
        実測の「極細の枠だけの丸い矢印ボタン」＋「左上だけ角丸の戻る」を使う。
        文字は右寄せで下に細い線、というところまで公式の作法に合わせてある。
      */}
      <a class="ww-back" href={withBase('/wikis/')} data-astro-reload>
        <span class="ww-back-text">wiki 一覧へ</span>
        <span class="ww-circle" aria-hidden="true">
          <Icon name="lucide:arrow-right" />
        </span>
      </a>
    </div>
  </article>
</WuwaLayout>
