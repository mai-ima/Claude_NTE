---
/**
 * 崩壊：スターレイル 攻略wiki（準備中）専用レイアウト。
 *
 * 読み込む CSS は hsr.css だけ。ほかの wiki とは一切共有しない。
 * 意匠の根拠とどこまでが解釈かは docs/UI-RESEARCH.md に書いてある。
 * ※ 公式の画像・ロゴ・フォントは同梱しない。
 */
import '../styles/hsr.css';
import SiteStateGate from '../components/SiteStateGate.astro';
import PlannedHead from '../components/PlannedHead.astro';
import { withBase } from '../lib/path';
import { wiki } from '../lib/wikis';
import { COMMON_FOOTER_LINKS } from '../lib/nav';

const w = wiki('hsr');
---

<!doctype html>
<html lang="ja">
  <head>
    <PlannedHead wikiId="hsr" themeColor="#121212" />
  </head>
  <body>
    <div class="hsr-shell">
      <header class="hsr-head">
        {/* マークは画像ではなく文字で作る（公式ロゴは使わない） */}
        <span class="hsr-mark" aria-hidden="true">星</span>
        <span class="hsr-brand">崩壊：スターレイル 攻略wiki</span>
        {/*
          実画面の黒ヘッダーにあった大文字英字メニュー（HOME / NEWS / CHARACTER / WORLD、
          現在地は青）を写した意匠。まだ行き先が無いのでリンクにはせず、
          読み上げからも外す（aria-hidden）。docs/UI-RESEARCH.md 参照。
        */}
        <nav class="hsr-nav" aria-hidden="true">
          <span class="is-here">HOME</span>
          <span>NEWS</span>
          <span>CHARACTER</span>
          <span>WORLD</span>
        </nav>
      </header>

      <main class="hsr-main">
        <slot />
      </main>

      <footer class="hsr-foot">
        <p>{w.footer}</p>
        <p>
          {/* 並びの定義は src/lib/nav.ts の COMMON_FOOTER_LINKS
              （6つのレイアウトで同じものを出す。増やすときはそこだけ直す） */}
          <a href={withBase('/')} data-astro-reload>NTE 完全攻略wiki</a>
          {
            COMMON_FOOTER_LINKS.map((l) => (
              <>
                <span aria-hidden="true"> ／ </span>
                <a href={withBase(l.href)} data-astro-reload>
                  {l.label}
                </a>
              </>
            ))
          }
        </p>
      </footer>
    </div>
    {/* サイトの状態（メンテナンス／停止）の案内。通常営業なら何も出ない。 */}
    <SiteStateGate />
  </body>
</html>
