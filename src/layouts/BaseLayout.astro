---
import '../styles/themes.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/ui-new-classic.css';
import '../styles/ui-editorial.css';
import '../styles/ui-liquid.css';
import '../styles/ui-aurora.css';
import '../styles/ui-apple.css';
import '../styles/ui-terminal.css';
import '../styles/ui-clay.css';
import '../styles/ui-blueprint.css';
import '../styles/prefs.css';
import { ClientRouter } from 'astro:transitions';
import { Icon } from 'astro-icon/components';
import { withBase, activeHref } from '../lib/path';
import { PRIMARY_NAV, BOTTOM_NAV } from '../lib/nav';
import MobileDrawer from '../components/MobileDrawer.astro';
import ThemeMenu from '../components/ThemeMenu';
import Search from 'astro-pagefind/components/Search';

interface Crumb {
  name: string;
  href: string;
}
interface Props {
  title?: string;
  description?: string;
  /** 'article' を渡すとコンテンツ記事として OG/JSON-LD を出力 */
  ogType?: 'website' | 'article';
  /** 記事の最終更新日（article のとき article:modified_time / JSON-LD に反映） */
  modified?: Date;
  /** パンくず（BreadcrumbList JSON-LD 用）。先頭にホームを含めなくてよい */
  breadcrumbs?: Crumb[];
  /** OG/Twitter 画像のサイト内パス（例: 'og/characters/x.png'）。未指定は既定アイコン */
  image?: string;
}

const {
  title,
  description = 'NTE（Neverness to Everness）に関する攻略・情報をまとめた非公式ファンwiki + 各種ツール。',
  ogType = 'website',
  modified,
  breadcrumbs = [],
  image,
} = Astro.props;

const siteName = 'NTE 完全攻略wiki';
const fullTitle = title ? `${title} | ${siteName}` : siteName;
const currentPath = Astro.url.pathname;
// ナビは「最長一致の1件だけ」を現在ページ扱いにする（/tools と /tools/tier-list の二重ハイライト防止）
const primaryActive = activeHref(currentPath, PRIMARY_NAV.map((n) => n.href));
const bottomActive = activeHref(currentPath, BOTTOM_NAV.map((n) => n.href));
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(withBase(image ?? 'icons/icon-192.png'), Astro.site).href;
const homeUrl = new URL(withBase('/'), Astro.site).href;

// --- 構造化データ (JSON-LD) ---
const ldGraph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': `${homeUrl}#website`,
    url: homeUrl,
    name: siteName,
    description,
    inLanguage: 'ja',
  },
];
if (ogType === 'article') {
  ldGraph.push({
    '@type': 'Article',
    headline: title ?? siteName,
    description,
    inLanguage: 'ja',
    mainEntityOfPage: canonical,
    isPartOf: { '@id': `${homeUrl}#website` },
    ...(modified ? { dateModified: modified.toISOString() } : {}),
  });
}
const crumbItems = [{ name: 'ホーム', href: withBase('/') }, ...breadcrumbs];
if (crumbItems.length > 1) {
  ldGraph.push({
    '@type': 'BreadcrumbList',
    itemListElement: crumbItems.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: new URL(c.href, Astro.site).href,
    })),
  });
}
// `<` をエスケープして、タイトル等に </script> が含まれても HTML が壊れないようにする
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': ldGraph }).replace(
  /</g,
  '\\u003c',
);
---

<!doctype html>
<html lang="ja" data-theme="minimal">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#fafafa" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('icons/icon-192.png')} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ja_JP" />
    {ogType === 'article' && modified && (
      <meta property="article:modified_time" content={modified.toISOString()} />
    )}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />
    {/* ページ遷移のビュートランジション（ネイティブアプリ的な遷移）。
        prefers-reduced-motion 時は Astro が自動で縮退する。 */}
    <ClientRouter />
    <script type="application/ld+json" set:html={jsonLd} is:inline />

    {/* テーマ＆UIモードを描画前に適用（チラつき防止）。is:inline なのでバンドルされない素のJS。
        data-astro-rerun: View Transitions の swap 後も再実行し、theme/ui/prefs を再適用する。 */}
    <script is:inline data-astro-rerun>
      (function () {
        try {
          var t = localStorage.getItem('nte.theme');
          var valid = ['minimal', 'dark', 'soft', 'auto'];
          if (!t || valid.indexOf(t) === -1) t = 'minimal';
          document.documentElement.setAttribute('data-theme', t);
          var color = { minimal: '#fafafa', dark: '#0f1115', soft: '#faf6f0' }[t];
          if (t === 'auto') {
            color = window.matchMedia('(prefers-color-scheme: dark)').matches
              ? '#0f1115'
              : '#fafafa';
          }
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta && color) meta.setAttribute('content', color);
          var ui = localStorage.getItem('nte.ui');
          if (ui === 'beta') ui = 'editorial'; // 旧ベータからの移行
          var uiValid = ['classic', 'new-classic', 'editorial', 'liquid', 'aurora', 'apple', 'terminal', 'clay', 'blueprint'];
          if (uiValid.indexOf(ui) === -1) ui = 'classic';
          document.documentElement.setAttribute('data-ui', ui);
          // 表示の追加設定（ベータ）。src/lib/prefs.ts の PREFS と並びを揃えること。
          var prefs = [
            ['nte.motion', 'motion', 'reduce'],
            ['nte.autoterm', 'autoterm', 'off'],
            ['nte.spoiler', 'spoiler', 'open'],
            ['nte.width', 'width', 'wide'],
            ['nte.draftmark', 'draftmark', 'on'],
            ['nte.edit', 'edit', 'on'],
          ];
          for (var i = 0; i < prefs.length; i++) {
            if (localStorage.getItem(prefs[i][0]) === '1') {
              document.documentElement.setAttribute('data-' + prefs[i][1], prefs[i][2]);
            }
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    {/* Liquid Glass UI 用の屈折フィルタ。backdrop-filter: url(#lq-glass) が対応する
        環境でのみガラス面の背後を歪ませる（iOS 26 風のレンズ表現）。非表示・非干渉。 */}
    <svg
      aria-hidden="true"
      focusable="false"
      width="0"
      height="0"
      style="position:absolute;width:0;height:0;overflow:hidden;pointer-events:none"
    >
      <filter id="lq-glass" x="-20%" y="-20%" width="140%" height="140%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.009 0.013" numOctaves="2" seed="7" result="noise"></feTurbulence>
        <feGaussianBlur in="noise" stdDeviation="1.4" result="snoise"></feGaussianBlur>
        <feDisplacementMap in="SourceGraphic" in2="snoise" scale="16" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
      </filter>
    </svg>
    <div class="app">
      <header class="app-header" transition:persist>
        <button
          class="btn btn-icon btn-ghost drawer-toggle"
          type="button"
          aria-label="メニューを開く"
          data-drawer-open
        >
          <Icon name="lucide:menu" />
        </button>

        <a class="brand" href={withBase('/')}>
          <span class="brand-mark">NTE</span>
          <span>完全攻略wiki</span>
        </a>

        <div class="header-spacer"></div>

        <nav class="cluster" aria-label="グローバルナビ" style="gap:2px;">
          {
            PRIMARY_NAV.filter((n) => n.href !== '/').map((item) => (
              <a
                class="nav-link"
                href={withBase(item.href)}
                style="padding:8px 10px;"
                aria-current={item.href === primaryActive ? 'page' : undefined}
              >
                <Icon name={`lucide:${item.icon}`} />
                <span class="sr-only sm-show">{item.label}</span>
              </a>
            ))
          }
        </nav>

        <button
          class="btn btn-icon btn-ghost"
          type="button"
          aria-label="検索（⌘K / Ctrl+K）"
          data-search-open
        >
          <Icon name="lucide:search" />
        </button>

        <ThemeMenu client:load />
      </header>

      <dialog id="search-dialog" class="search-modal" aria-label="サイト内検索" transition:persist>
        <div class="search-modal-head">
          <span class="muted text-sm">サイト内を検索（<kbd>Esc</kbd> で閉じる）</span>
          <button class="btn btn-icon btn-ghost" type="button" aria-label="閉じる" data-search-close>
            <Icon name="lucide:x" />
          </button>
        </div>
        <Search id="global-search" className="pagefind-ui" uiOptions={{ showImages: false, excerptLength: 15 }} />
      </dialog>

      <MobileDrawer currentPath={currentPath} transition:persist />

      <main class="app-main">
        <slot />
      </main>

      <footer class="app-footer">
        <p>
          NTE 完全攻略wiki — 非公式ファンサイト。各記事は出典を明記し、未確認情報には「要確認」を付しています。
          <br />
          ゲーム内画像・地図等の権利はすべて Hotta Studio / Perfect World Games に帰属します。
        </p>
      </footer>

      <nav class="bottom-nav" aria-label="モバイルナビ" transition:persist>
        {
          BOTTOM_NAV.map((item) => (
            <a
              href={withBase(item.href)}
              aria-current={item.href === bottomActive ? 'page' : undefined}
            >
              <Icon name={`lucide:${item.icon}`} />
              <span>{item.label}</span>
            </a>
          ))
        }
      </nav>
    </div>

    <script>
      // モバイルドロワーの開閉。ヘッダー/ドロワーは transition:persist で永続化されるため、
      // リスナーは初回1回の登録で View Transitions 後も有効。
      const drawer = document.getElementById('app-drawer');
      function setDrawer(open: boolean) {
        if (!drawer) return;
        drawer.classList.toggle('is-open', open);
        document.body.style.overflow = open ? 'hidden' : '';
      }
      document.querySelector('[data-drawer-open]')?.addEventListener('click', () => setDrawer(true));
      document
        .querySelectorAll('[data-drawer-close]')
        .forEach((el) => el.addEventListener('click', () => setDrawer(false)));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setDrawer(false);
      });

      // View Transitions: 永続ナビ(header/bottom-nav)の現在地ハイライトは静的HTMLのままなので、
      // 遷移ごとに location から再計算する。あわせてドロワーを閉じる。
      function pathOf(href: string) {
        try {
          return new URL(href, location.origin).pathname.replace(/\/$/, '');
        } catch {
          return '';
        }
      }
      function syncActiveNav() {
        const cur = location.pathname.replace(/\/$/, '');
        const home = pathOf('/');
        for (const sel of ['.app-header .nav-link', '.bottom-nav a']) {
          const links = Array.from(document.querySelectorAll(sel)) as HTMLAnchorElement[];
          let best: HTMLAnchorElement | null = null;
          let bestLen = -1;
          for (const a of links) {
            const tgt = pathOf(a.href);
            const match = tgt === home ? cur === home : cur === tgt || cur.startsWith(tgt + '/');
            if (match && tgt.length > bestLen) {
              best = a;
              bestLen = tgt.length;
            }
          }
          for (const a of links) a.removeAttribute('aria-current');
          if (best) best.setAttribute('aria-current', 'page');
        }
      }
      // グローバル検索モーダル（⌘K / Ctrl+K / "/" で開く）。dialog は永続化済みで
      // リスナーは初回登録のみ。
      const searchDialog = document.getElementById('search-dialog') as HTMLDialogElement | null;
      function openSearch() {
        if (!searchDialog || searchDialog.open) return;
        searchDialog.showModal();
        const input = searchDialog.querySelector('input');
        if (input) (input as HTMLInputElement).focus();
      }
      function closeSearch() {
        searchDialog?.close();
      }
      document.querySelector('[data-search-open]')?.addEventListener('click', openSearch);
      searchDialog?.querySelector('[data-search-close]')?.addEventListener('click', closeSearch);
      // 背景（::backdrop）クリックで閉じる
      searchDialog?.addEventListener('click', (e) => {
        if (e.target === searchDialog) closeSearch();
      });
      document.addEventListener('keydown', (e) => {
        const meta = e.metaKey || e.ctrlKey;
        if (meta && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          openSearch();
          return;
        }
        const t = e.target as HTMLElement | null;
        const typing = t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable);
        if (e.key === '/' && !typing && !searchDialog?.open) {
          e.preventDefault();
          openSearch();
        }
      });

      document.addEventListener('astro:page-load', () => {
        setDrawer(false);
        closeSearch();
        syncActiveNav();
      });
    </script>

    <style>
      .sm-show {
        position: static;
        width: auto;
        height: auto;
        clip: auto;
        margin: 0;
      }
      @media (max-width: 640px) {
        .sm-show {
          display: none;
        }
      }
    </style>
  </body>
</html>
