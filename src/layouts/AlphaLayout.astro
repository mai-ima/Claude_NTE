---
/**
 * αテスト（仮）wiki 専用レイアウト。
 *
 * NTE 側の BaseLayout とは**完全に独立**している（共通のCSS・ナビ・テーマを
 * 一切読み込まない）。α wiki の見た目・操作感をここだけで完結させることで、
 * 「別ゲームの wiki は別のUIで運用できる」ことを実地で確かめている。
 *
 * - スタイル: src/styles/alpha.css のみ
 * - テーマ: OS 連動 ＋ 手動切替（localStorage 'alpha.theme'／NTE とは別キー）
 * - ナビ: モバイル＝下部タブ／デスクトップ＝左サイド
 */
import '../styles/alpha.css';
import { Icon } from 'astro-icon/components';
import { withBase, activeHref } from '../lib/path';
import { wiki } from '../lib/wikis';
import { loadNavSections } from '../lib/content';

interface Crumb {
  name: string;
  href: string;
}
interface Props {
  title?: string;
  description?: string;
  /** パンくず（ホームは自動で先頭に付く） */
  breadcrumbs?: Crumb[];
}
const { title, description, breadcrumbs = [] } = Astro.props;

const w = wiki('alpha');
const siteName = w.siteName;
const fullTitle = title ? `${title} | ${siteName}` : siteName;
const desc = description ?? w.description;
const currentPath = Astro.url.pathname;
const canonical = new URL(currentPath, Astro.site).href;

// 記事のあるセクションだけをナビに出す（件数も添える）
const sections = await loadNavSections(w.sections);
const countOf = (c: string) => sections.find((s) => s.collection === c)?.items.length ?? 0;

const home = { label: 'ホーム', href: '/alpha/', icon: 'home' };
const navItems = [home, ...w.sections.map((s) => ({ label: s.label, href: s.href, icon: s.icon }))];
// 下部タブは指が届く 5 枠まで
const tabs = navItems.slice(0, 5);
const activeNav = activeHref(currentPath, navItems.map((n) => n.href));

const crumbItems = [{ name: 'αテストwiki', href: withBase('/alpha/') }, ...breadcrumbs];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('icons/icon-192.png')} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="format-detection" content="telephone=no" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="ja_JP" />
    {/* サンプルwikiなので検索エンジンには載せない（NTE 側の評価を薄めないため） */}
    <meta name="robots" content="noindex, follow" />
    <meta name="generator" content={Astro.generator} />

    {/* 描画前にテーマとテーマカラーを確定させる（チラつき防止） */}
    <script is:inline>
      (function () {
        try {
          // iPhone / iPad（iPadOS は Mac を名乗るので touch 有無で見分ける）
          var ua = navigator.userAgent || '';
          if (
            /iPad|iPhone|iPod/.test(ua) ||
            (ua.indexOf('Macintosh') !== -1 && navigator.maxTouchPoints > 1)
          ) {
            document.documentElement.setAttribute('data-ios', '1');
          }
          var t = localStorage.getItem('alpha.theme');
          if (t === 'dark' || t === 'light') {
            document.documentElement.setAttribute('data-a-theme', t);
          }
          var dark =
            t === 'dark' ||
            (t !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          var m = document.createElement('meta');
          m.name = 'theme-color';
          m.content = dark ? '#0e0e14' : '#f7f7fb';
          document.head.appendChild(m);
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <div class="a-shell">
      <header class="a-top">
        <a class="a-brand" href={withBase('/alpha/')}>
          <span class="a-logo">α</span>
          <span>
            αテストwiki
            <small>サンプル・実験用</small>
          </span>
        </a>

        <div class="a-top-spacer"></div>

        <button class="a-icon-btn" type="button" data-a-theme-toggle aria-label="配色を切り替え">
          <Icon name="lucide:sun-moon" />
        </button>
        {/* NTE wiki への切替。アイコンだけだと「ホーム」と誤解されて誤タップされるため、
            ラベル（NTE）を添えて行き先が分かるようにしている。 */}
        <a class="a-switch" href={withBase('/')} aria-label="NTE 完全攻略wiki へ移動">
          <Icon name="lucide:arrow-left-right" />
          <span>NTE</span>
        </a>
      </header>

      <nav class="a-side" aria-label="αテストwiki ナビゲーション">
        <div class="a-side-group">
          <p class="a-side-title">メニュー</p>
          {
            navItems.map((item) => (
              <a
                href={withBase(item.href)}
                aria-current={item.href === activeNav ? 'page' : undefined}
              >
                <Icon name={`lucide:${item.icon}`} />
                <span>{item.label}</span>
                {item.href !== '/alpha/' && (
                  <span class="a-side-count">
                    {countOf(w.sections.find((s) => s.href === item.href)?.collection ?? '')}
                  </span>
                )}
              </a>
            ))
          }
        </div>
        <div class="a-side-group">
          <p class="a-side-title">ほかの wiki</p>
          <a href={withBase('/')}>
            <Icon name="lucide:book-open" />
            <span>NTE 完全攻略wiki</span>
          </a>
          <a href={withBase('/wikis/')}>
            <Icon name="lucide:library" />
            <span>wiki 一覧</span>
          </a>
        </div>
      </nav>

      <main class="a-main">
        <div class="a-wrap">
          {
            crumbItems.length > 1 && (
              <nav class="a-crumbs" aria-label="パンくず">
                {crumbItems.map((c, i) => (
                  <>
                    {i > 0 && <Icon name="lucide:chevron-right" />}
                    {i === crumbItems.length - 1 ? (
                      <span>{c.name}</span>
                    ) : (
                      <a href={c.href}>{c.name}</a>
                    )}
                  </>
                ))}
              </nav>
            )
          }
          <slot />
        </div>
      </main>

      <footer class="a-foot">
        <p>{w.footer}</p>
        <p>
          <a href={withBase('/')}>NTE 完全攻略wiki へ移動</a>
          <span aria-hidden="true"> / </span>
          <a href={withBase('/wikis/')}>wiki 一覧</a>
        </p>
      </footer>

      <nav class="a-tabs" aria-label="メインナビ">
        {
          tabs.map((item) => (
            <a href={withBase(item.href)} aria-current={item.href === activeNav ? 'page' : undefined}>
              <Icon name={`lucide:${item.icon}`} />
              <span>{item.label}</span>
              <span class="a-tab-dot" />
            </a>
          ))
        }
      </nav>
    </div>

    <script>
      // 配色の手動切替（OS 連動 → 明 → 暗 → OS 連動 …）。NTE 側とはキーを分ける。
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement | null)?.closest('[data-a-theme-toggle]');
        if (!btn) return;
        const root = document.documentElement;
        const cur = root.getAttribute('data-a-theme');
        const next = cur === 'light' ? 'dark' : cur === 'dark' ? null : 'light';
        if (next) root.setAttribute('data-a-theme', next);
        else root.removeAttribute('data-a-theme');
        try {
          if (next) localStorage.setItem('alpha.theme', next);
          else localStorage.removeItem('alpha.theme');
        } catch {
          /* 保存できなくても表示は切り替える */
        }
        const dark =
          next === 'dark' ||
          (!next && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', dark ? '#0e0e14' : '#f7f7fb');
      });

      // ※ スクロール位置の復元は自前で持たない。α は素のページ遷移なので
      //    ブラウザの標準復元（history.scrollRestoration = 'auto'）が効く。
      //    実測でも「一覧 → 記事 → 戻る」で元の位置に戻ることを確認済み。

      // 横に長い表はスクロールできるようラップする（スマホで崩れないように）
      for (const table of Array.from(document.querySelectorAll('.a-prose table'))) {
        if (table.parentElement?.classList.contains('a-table-scroll')) continue;
        const box = document.createElement('div');
        box.className = 'a-table-scroll';
        table.replaceWith(box);
        box.appendChild(table);
      }
    </script>
  </body>
</html>
