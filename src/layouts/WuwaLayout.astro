---
/**
 * 鳴潮（Wuthering Waves）攻略wiki（準備中）専用レイアウト。
 *
 * 読み込む CSS は wuwa.css だけ。ほかの wiki とは一切共有しない。
 * 意匠の根拠とどこまでが解釈かは docs/UI-RESEARCH.md に書いてある。
 * ※ 公式の画像・ロゴ・フォントは同梱しない。
 */
import '../styles/wuwa.css';
import { withBase } from '../lib/path';
import { wiki } from '../lib/wikis';

const w = wiki('wuwa');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{w.siteName}</title>
    <meta name="description" content={w.description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#000000" />
    {/* 中身がまだ無いページを検索結果に載せない。sitemap からも除いてある。 */}
    <meta name="robots" content="noindex, follow" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <div class="ww-shell">
      <header class="ww-head">
        {/* マークは画像ではなく文字で作る（公式ロゴは使わない） */}
        <span class="ww-mark" aria-hidden="true">鳴</span>
        <span class="ww-brand">鳴潮 攻略wiki</span>
        {/*
          公式は欧文に Novecentowide（幅広の大文字向けサンセリフ）を使っていた。
          フォントは同梱しないので、大文字＋広い字間で雰囲気だけ寄せる。
        */}
        <span class="ww-head-en" aria-hidden="true">Wuthering Waves</span>
      </header>

      <main class="ww-main">
        <slot />
      </main>

      <footer class="ww-foot">
        <p>{w.footer}</p>
        <p>
          <a href={withBase('/')} data-astro-reload>NTE 完全攻略wiki</a>
          <span aria-hidden="true"> ／ </span>
          <a href={withBase('/wikis/')} data-astro-reload>wiki 一覧</a>
        </p>
      </footer>
    </div>
  </body>
</html>
