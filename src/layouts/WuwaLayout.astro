---
/**
 * 鳴潮（Wuthering Waves）攻略wiki（準備中）専用レイアウト。
 *
 * 読み込む CSS は wuwa.css だけ。ほかの wiki とは一切共有しない。
 * 意匠の根拠とどこまでが解釈かは docs/UI-RESEARCH.md に書いてある。
 * ※ 公式の画像・ロゴ・フォントは同梱しない。
 */
import '../styles/wuwa.css';
import SiteStateGate from '../components/SiteStateGate.astro';
import PlannedHead from '../components/PlannedHead.astro';
import { withBase } from '../lib/path';
import { wiki } from '../lib/wikis';
import { COMMON_FOOTER_LINKS } from '../lib/nav';

const w = wiki('wuwa');
---

<!doctype html>
<html lang="ja">
  <head>
    <PlannedHead wikiId="wuwa" themeColor="#000000" />
  </head>
  <body>
    <div class="ww-shell">
      <header class="ww-head">
        {/* マークは画像ではなく文字で作る（公式ロゴは使わない） */}
        <span class="ww-mark" aria-hidden="true">鳴</span>
        <span class="ww-brand">鳴潮 攻略wiki</span>
        {/*
          公式は欧文に Novecentowide（幅広の大文字向けサンセリフ）を使っていた。
          フォントは同梱しないので、大文字＋広い字間で雰囲気だけ寄せる。
        */}
        <span class="ww-head-en" aria-hidden="true">Wuthering Waves</span>
      </header>

      <main class="ww-main">
        <slot />
      </main>

      <footer class="ww-foot">
        <p>{w.footer}</p>
        <p>
          {/* 並びの定義は src/lib/nav.ts の COMMON_FOOTER_LINKS
              （6つのレイアウトで同じものを出す。増やすときはそこだけ直す） */}
          <a href={withBase('/')} data-astro-reload>NTE 完全攻略wiki</a>
          {
            COMMON_FOOTER_LINKS.map((l) => (
              <>
                <span aria-hidden="true"> ／ </span>
                <a href={withBase(l.href)} data-astro-reload>
                  {l.label}
                </a>
              </>
            ))
          }
        </p>
      </footer>
    </div>
    {/* サイトの状態（メンテナンス／停止）の案内。通常営業なら何も出ない。 */}
    <SiteStateGate />
  </body>
</html>
