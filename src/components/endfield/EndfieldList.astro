---
/**
 * エンドフィールド wiki の一覧ページ。
 *
 * α の AlphaList とは別物として組んである（箱ではなく罫線で区切る／番号を振る）。
 * **記事0件のときは「準備中」をはっきり出す**（空のページを黙って見せない）。
 */
import EndfieldLayout from '../../layouts/EndfieldLayout.astro';
import { Icon } from 'astro-icon/components';
import { withBase } from '../../lib/path';
import { hrefOf, titleOf } from '../../lib/content';
import { sectionByCollection } from '../../lib/nav';
import { wiki } from '../../lib/wikis';
import { findLocalImage } from '../../lib/asset';
import { EF_CLASSES, EF_ELEMENTS, efClassKey, efElementKey } from '../../lib/endfield';

interface Props {
  collection: string;
  entries: { id: string; data: Record<string, unknown> }[];
  /** 見出しの英字ラベル（01 / OPERATORS の右側） */
  eyebrow: string;
}
type Item = Props['entries'][number];
const { collection, entries, eyebrow } = Astro.props;

const section = sectionByCollection(collection)!;

/** 前後のセクション。一覧の下端にページャとして出す（実測のピル型ページャ）。 */
const all = wiki('endfield').sections;
const idx = all.findIndex((x) => x.collection === collection);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : null;

/** 記事の並びは order → 名前順。order が無い記事は後ろに寄せる。 */
const sorted = [...entries].sort((a, b) => {
  const oa = (a.data.order as number) ?? 100;
  const ob = (b.data.order as number) ?? 100;
  if (oa !== ob) return oa - ob;
  return titleOf(a as never).localeCompare(titleOf(b as never), 'ja');
});

/* ---- 並び替えの順位を先に計算しておく ------------------------------------
   公式サイトの一覧には「オペレーター ▾」「総合順 ▾」の2つのセレクトがある
   （`Dropdown_trigger` 170×36・地 rgb(58,58,58)・白文字 14.625px）。
   こちらも**並び順を選べる**ようにする。

   ★ JavaScript で並べ替えない。CSS の `order` を使う。
     NTE 側（`EntityList.astro`）と同じ作法で、**JS が動かなくても既定の並びで読める**。
     順位はここで計算して `style` に埋め、`endfield.css` が拾う。 */
const freshMs = (e: Item) => {
  const d = e.data as Record<string, unknown>;
  const u = d.updated instanceof Date ? d.updated.getTime() : 0;
  const c = d.checked instanceof Date ? d.checked.getTime() : 0;
  return Math.max(u, c);
};
/** レア度の「★6」から数字を取り出す。無いものは0（いちばん後ろ） */
const rarityNum = (e: Item) => Number(String((e.data as Record<string, unknown>).rarity ?? '').replace(/[^0-9]/g, '')) || 0;

const ordName = new Map(
  [...sorted].sort((a, b) => titleOf(a as never).localeCompare(titleOf(b as never), 'ja')).map((e, i) => [e.id, i]),
);
const ordUpdated = new Map([...sorted].sort((a, b) => freshMs(b) - freshMs(a)).map((e, i) => [e.id, i]));
const ordRarity = new Map(
  [...sorted]
    .sort((a, b) => rarityNum(b) - rarityNum(a) || titleOf(a as never).localeCompare(titleOf(b as never), 'ja'))
    .map((e, i) => [e.id, i]),
);
const ordVars = (e: Item) =>
  `--ord-name:${ordName.get(e.id) ?? 0};--ord-updated:${ordUpdated.get(e.id) ?? 0};--ord-rarity:${ordRarity.get(e.id) ?? 0}`;
/** レア度を持つ一覧でだけ「レア度順」を出す（武器・オペレーターなど） */
const hasRarity = sorted.some((e) => rarityNum(e) > 0);

/** 絵の置き場。`endfieldOperators` → `public/images/official/endfield/operators/` */
const imgDir = collection.replace(/^endfield/, '').toLowerCase();
/** その記事の絵（公式サイトから同梱したもの）。無ければ null */
const imageOf = (id: string) => findLocalImage(`official/endfield/${imgDir}`, id);

/* 絞り込みの軸。**値が2つ以上あるときだけ**出す（1種類しかない軸を並べても押せないだけ）。 */
const valuesOf = (field: string) =>
  [...new Set(sorted.map((e) => (e.data as Record<string, unknown>)[field]).filter(Boolean))].map(
    String,
  );
const classValues = EF_CLASSES.filter((c) => valuesOf('class').includes(c.label));
const elementValues = EF_ELEMENTS.filter((e) => valuesOf('element').includes(e.label));
const rarityValues = ['★6', '★5', '★4', '★3', '★2', '★1'].filter((r) => valuesOf('rarity').includes(r));

/* 職業・属性を持たない項目（武器・装備・アイテム・設備・脅威）にも絞り込みを出す。
   どの欄を使うかはコレクションごとに違うので、ここで対応づける。 */
const KIND_FIELD: Record<string, { label: string; field: string }> = {
  endfieldWeapons: { label: '武器種', field: 'type' },
  endfieldGear: { label: '部位', field: 'slot' },
  endfieldItems: { label: '区分', field: 'type' },
  endfieldIndustry: { label: '区分', field: 'category' },
  endfieldEnemies: { label: '分類', field: 'type' },
};
const kind = KIND_FIELD[collection];
/** 件数の多い順。1件しかない値を並べても押せないだけなので落とす */
const kindValues = kind
  ? [...new Set(sorted.map((e) => (e.data as Record<string, unknown>)[kind.field]).filter(Boolean))]
      .map(String)
      .map((v) => ({
        v,
        n: sorted.filter((e) => String((e.data as Record<string, unknown>)[kind.field] ?? '') === v).length,
      }))
      .filter((x) => x.n > 1)
      .sort((a, b) => b.n - a.n)
      .slice(0, 12)
  : [];
const kindOf = (d: Record<string, unknown>) => (kind ? (d[kind.field] as string | undefined) : undefined);

const hasFilter =
  classValues.length + elementValues.length + rarityValues.length + kindValues.length > 1;

const no = (i: number) => String(i + 1).padStart(2, '0');
const fmt = (d: unknown) =>
  d instanceof Date ? d.toLocaleDateString('ja-JP', { timeZone: 'Asia/Tokyo' }) : null;
---

<EndfieldLayout
  title={section.label}
  description={section.blurb}
  breadcrumbs={[{ name: section.label, href: withBase(section.href) }]}
  wide
>
  {/*
    下層ページのヘッダー帯。公式は「上が白・下が蛍光イエローの2段ベタ＋下端に
    太い灰色の罫線」で、その上に**黒い正方形に黄色のアイコン**を置いていた
    （実測 .SubpageHeader / .decoHeader .icon → docs/UI-RESEARCH.md）。
  */}
  {/* `data-hollow` は、公式サイトの `HallowText`（279px の中抜き文字）を写した下敷き。
      帯の後ろにセクション名を大きく透かす。→ `endfield.css` の同名の節 */}
  <div class="ef-subhead" data-hollow={eyebrow}>
    <p class="ef-eyebrow">
      <span class="ef-sq-icon" aria-hidden="true">
        <Icon name={`lucide:${section.icon}`} />
      </span>
      {eyebrow}
      {/* 計器風の数値（実測 `REC 1 / 33` の見せ方）。12セクション中の何番目か。 */}
      <span class="ef-meter" style="margin-left:auto;">
        <em aria-hidden="true"></em>
        <b>{String(idx + 1).padStart(2, '0')}</b>
        <span>/ {String(all.length).padStart(2, '0')}</span>
      </span>
    </p>
    <h1 class="ef-title">{section.label}</h1>
  </div>
  <p class="ef-lead">{section.blurb}</p>

  {
    sorted.length > 0 && (
      /* 表示形式の切り替え。行 / タイル / 詳しく / 詰めて の4つ。
         選んだ形式は localStorage に残り、次に開いたときも同じ形で出る。 */
      <div class="ef-viewbar ef-mask-x" data-ef-viewbar>
        <span class="ef-viewbar-label">View</span>
        <button class="ef-viewbtn" type="button" data-ef-view-set="rows" aria-pressed="true">
          <Icon name="lucide:rows-3" />行
        </button>
        <button class="ef-viewbtn" type="button" data-ef-view-set="grid" aria-pressed="false">
          <Icon name="lucide:layout-grid" />タイル
        </button>
        <span class="ef-divider" aria-hidden="true"></span>
        <button class="ef-viewbtn" type="button" data-ef-view-set="detail" aria-pressed="false">
          <Icon name="lucide:align-left" />詳しく
        </button>
        <button class="ef-viewbtn" type="button" data-ef-view-set="compact" aria-pressed="false">
          <Icon name="lucide:list" />詰めて
        </button>
      </div>
    )
  }

  {
    sorted.length > 1 && (
      /* 並び順。公式サイトのセレクト（`Dropdown_trigger` 170×36・地 rgb(58,58,58)）に倣う。
         押すと `<html data-ef-sort>` が変わり、CSS の `order` で並びが入れ替わる。
         **JS が動かなくても既定の並びで読める**ので、壊れても困らない。 */
      <div class="ef-sortbar">
        <label class="ef-sort" for="ef-sort">
          <span class="ef-sort-label">並び順</span>
          <select class="ef-sort-select" id="ef-sort" data-ef-sort-set>
            <option value="default">標準</option>
            <option value="name">名前</option>
            {hasRarity && <option value="rarity">レア度が高い順</option>}
            <option value="updated">新しい順</option>
          </select>
        </label>
      </div>
    )
  }

  {
    hasFilter && (
      /* 絞り込み。常に見えている（開閉しない）。押すと CSS の `hidden` で行を隠し、
         件数を数え直す。JS が動かない端末でも**全件が見えたまま**なので壊れない。

         外側の `.ef-widget` は**公式wikiのかたまりの作法**
         （薄いグレーの帯 44px ＋ 16px 太字の見出し ＋ 左に 32×8 の飾り）。
         → docs/UI-RESEARCH.md 2026-09-14 の実測 */
      <section class="ef-widget">
        <header class="ef-widget-head">
          <span class="ef-widget-tag" aria-hidden="true" />
          <h2 class="ef-widget-title">絞り込み</h2>
          <span class="ef-widget-n">
            <b data-ef-count>{sorted.length}</b> 件
          </span>
        </header>
        <div class="ef-widget-body">
      <div class="ef-filter" data-ef-filter>
        <div class="ef-filter-row">
          {/* 「絞り込み」の見出しは**上の帯に出してある**ので、ここには置かない（二重になる） */}
          <button class="ef-chip is-on" type="button" data-ef-f="all" aria-pressed="true">
            すべて
          </button>
          {rarityValues.map((r) => (
            <button class="ef-chip" type="button" data-ef-f="rarity" data-ef-v={r} aria-pressed="false">
              {r}
            </button>
          ))}
        </div>
        {classValues.length > 1 && (
          <div class="ef-filter-row">
            <span class="ef-filter-label">職業</span>
            {classValues.map((c) => (
              <button
                class="ef-chip"
                type="button"
                data-ef-f="class"
                data-ef-v={c.label}
                aria-pressed="false"
              >
                <img src={withBase(`/images/official/endfield/classes/${c.key}.webp`)} alt="" width="18" height="18" />
                {c.label}
              </button>
            ))}
          </div>
        )}
        {elementValues.length > 1 && (
          <div class="ef-filter-row">
            <span class="ef-filter-label">属性</span>
            {elementValues.map((el) => (
              <button
                class="ef-chip"
                type="button"
                data-ef-f="element"
                data-ef-v={el.label}
                aria-pressed="false"
              >
                <img src={withBase(`/images/official/endfield/elements/${el.key}.webp`)} alt="" width="18" height="18" />
                {el.label}
              </button>
            ))}
          </div>
        )}
        {kind && kindValues.length > 1 && (
          <div class="ef-filter-row">
            <span class="ef-filter-label">{kind.label}</span>
            {kindValues.map((k) => (
              <button class="ef-chip" type="button" data-ef-f="kind" data-ef-v={k.v} aria-pressed="false">
                {k.v}
                <em class="ef-chip-n">{k.n}</em>
              </button>
            ))}
          </div>
        )}
        {/* 件数も**上の帯**に出してある。ここで繰り返さない */}
      </div>
        </div>
      </section>
    )
  }

  {
    sorted.length === 0 ? (
      <div class="ef-empty">
        <strong>この項目はまだ準備中です</strong>
        <p>
          公式の発表など、出典で裏が取れた内容から順に追加していきます。
        </p>
      </div>
    ) : (
      /* 一覧も公式wikiと同じ「かたまり」に入れる（薄いグレーの帯＋太字の見出し）。
         区切りは公式に倣って**中央寄せ90%幅の細線**にする（is-hairline）。 */
      <section class="ef-widget">
        <header class="ef-widget-head">
          <span class="ef-widget-tag" aria-hidden="true" />
          <h2 class="ef-widget-title">{section.label}</h2>
          <span class="ef-widget-n">
            <b data-ef-count>{sorted.length}</b> 件
          </span>
        </header>
        <div class="ef-widget-body">
      <div class="ef-list is-hairline ef-fade-b" data-dir={imgDir}>
        {sorted.map((e, i) => {
          const d = e.data;
          // 「いつ時点の情報か」は一覧でも分かるようにする（誠実性ルール）。
          // checked（確認しただけの日）が updated より新しければそちらを出す。
          const u = d.updated instanceof Date ? d.updated : null;
          const c = d.checked instanceof Date ? d.checked : null;
          const fresh = c && (!u || c > u) ? { kind: '確認', date: c } : u ? { kind: '更新', date: u } : null;
          const img = imageOf(e.id);
          const ck = efClassKey(d.class as string | undefined);
          const ek = efElementKey(d.element as string | undefined);
          return (
            <a
              class="ef-row"
              style={ordVars(e)}
              href={hrefOf(collection, e.id)}
              data-class={d.class as string | undefined}
              data-element={d.element as string | undefined}
              data-rarity={d.rarity as string | undefined}
              data-kind={kindOf(d as Record<string, unknown>)}
            >
              <span class="ef-row-no">{no(i)}</span>
              {img && (
                /* 顔のアップ（公式サイトの一覧と同じ絵）。左上に職業、その下に属性を重ねる */
                <span class="ef-thumb" aria-hidden="true">
                  {/* 背景画像ではなく `<img>` にしてある。
                      アイテムの一覧は530件あり、背景画像だと**開いた瞬間に全部読みに行く**。
                      `loading="lazy"` が効くのは `<img>` だけなので、こちらを使う。 */}
                  <img class="ef-thumb-pic" src={img} alt="" loading="lazy" decoding="async" width="56" height="56" />
                  {ck && <img class="ef-thumb-ic" src={withBase(`/images/official/endfield/classes/${ck}.webp`)} alt="" width="20" height="20" />}
                  {ek && <img class="ef-thumb-ic is-el" src={withBase(`/images/official/endfield/elements/${ek}.webp`)} alt="" width="20" height="20" />}
                </span>
              )}
              <span class="ef-row-body">
                <span class="ef-row-name">{titleOf(e as never)}</span>
                {d.rarity && <span class="ef-rar">{d.rarity as string}</span>}
                {d.description && <p class="ef-row-desc">{d.description as string}</p>}
              </span>
              <span class="ef-row-meta">
                {d.status === 'draft' && <span class="ef-badge is-draft">要確認</span>}
                {fresh && ` ${fresh.kind} ${fmt(fresh.date)}`}
              </span>
            </a>
          );
        })}
      </div>
        </div>
      </section>
    )
  }

  {
    sorted.length > 6 && (
      /* 公式は画面の下端に「SCROLL」の絵を置き、上下に動かして先があることを示す。
         記事が少ないときは出さない（スクロールの余地が無いため）。 */
      <div class="ef-scrolltip" aria-hidden="true">
        <img src={withBase('/images/official/endfield/ui/scroll-tip.webp')} alt="" width="48" height="38" loading="lazy" />
        <i />
      </div>
    )
  }

  {/*
    前後のセクションへのページャ。実測のページャ
    （ピル型の外枠＋二重リングの丸ボタン・ホバーで蛍光イエロー）をここで使う。
  */}
  <nav class="ef-pager" aria-label="前後のセクション">
    {
      prev ? (
        <a class="ef-pager-side" href={withBase(prev.href)}>
          <span class="ef-round" aria-hidden="true">
            <Icon name="lucide:chevron-left" />
          </span>
          <span class="ef-pager-txt">
            <span class="ef-pager-dir">Prev</span>
            <span class="ef-pager-name">{prev.label}</span>
          </span>
        </a>
      ) : (
        <span />
      )
    }
    <span class="ef-chevrons is-live" aria-hidden="true"><i></i><i></i><i></i></span>
    {
      next ? (
        <a class="ef-pager-side is-end" href={withBase(next.href)}>
          <span class="ef-round" aria-hidden="true">
            <Icon name="lucide:chevron-right" />
          </span>
          <span class="ef-pager-txt">
            <span class="ef-pager-dir">Next</span>
            <span class="ef-pager-name">{next.label}</span>
          </span>
        </a>
      ) : (
        <span />
      )
    }
  </nav>
</EndfieldLayout>

{/*
  表示形式の切り替え。描画前の適用は EndfieldLayout の起動スクリプトが済ませている
  （ちらつき防止）。ここでは押したときの反映と、現在の形式のボタンを押下状態にする。
*/}
<script is:inline data-astro-rerun>
  (function () {
    var bar = document.querySelector('[data-ef-viewbar]');
    if (!bar) return;
    var root = document.documentElement;
    function mark() {
      var now = root.getAttribute('data-ef-view') || 'rows';
      for (var b of bar.querySelectorAll('[data-ef-view-set]')) {
        b.setAttribute('aria-pressed', String(b.dataset.efViewSet === now));
      }
    }
    bar.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-ef-view-set]');
      if (!btn) return;
      var v = btn.dataset.efViewSet;
      if (v === 'rows') root.removeAttribute('data-ef-view');
      else root.setAttribute('data-ef-view', v);
      try {
        localStorage.setItem('endfield.view', v);
      } catch (err) {
        /* 保存できなくても切り替えは効く */
      }
      mark();
    });
    mark();
  })();
</script>

{/*
  並び順。`<html data-ef-sort>` を変えるだけで、並べ替えは CSS の `order` が行う。
  選んだ並びは localStorage に残り、次に開いたときも同じ順で出る。
*/}
<script is:inline data-astro-rerun>
  (function () {
    var sel = document.querySelector('[data-ef-sort-set]');
    if (!sel || sel.dataset.bound) return;
    sel.dataset.bound = '1';
    var root = document.documentElement;
    try {
      var saved = localStorage.getItem('endfield.sort');
      if (saved && [...sel.options].some((o) => o.value === saved)) {
        sel.value = saved;
        if (saved !== 'default') root.setAttribute('data-ef-sort', saved);
      }
    } catch (err) {
      /* 読めなくても既定の並びで出る */
    }
    sel.addEventListener('change', function () {
      var v = sel.value;
      if (v === 'default') root.removeAttribute('data-ef-sort');
      else root.setAttribute('data-ef-sort', v);
      try {
        localStorage.setItem('endfield.sort', v);
      } catch (err) {
        /* 保存できなくても並べ替えは効く */
      }
    });
  })();
</script>

{/*
  絞り込み。職業・属性・レア度を **AND** で掛ける（同じ軸の中は1つだけ選べる）。
  行の `data-*` を見て隠すだけなので、並び順や表示形式とぶつからない。
*/}
<script is:inline data-astro-rerun>
  (function () {
    var bar = document.querySelector('[data-ef-filter]');
    var list = document.querySelector('.ef-list');
    if (!bar || !list || bar.dataset.bound) return;
    bar.dataset.bound = '1';
    var pick = {};
    function apply() {
      var rows = list.querySelectorAll('.ef-row');
      var n = 0;
      for (var r of rows) {
        var ok = true;
        for (var k in pick) {
          if (pick[k] && r.dataset[k] !== pick[k]) ok = false;
        }
        r.hidden = !ok;
        if (ok) n++;
      }
      /* 件数は**2か所**にある（公式wikiに倣った見出しの帯と、絞り込みの下）。
         `bar`（= `[data-ef-filter]`）の中だけを探すと**帯の方が古いまま**になるので、
         枠（`.ef-widget`）まで広げて数え直す。 */
      var scope = bar.closest('.ef-widget') || bar;
      for (var out of scope.querySelectorAll('[data-ef-count]')) out.textContent = String(n);
      var none = Object.keys(pick).every(function (k) {
        return !pick[k];
      });
      for (var b of bar.querySelectorAll('[data-ef-f]')) {
        var f = b.dataset.efF;
        var on = f === 'all' ? none : pick[f] === b.dataset.efV;
        b.setAttribute('aria-pressed', String(on));
        b.classList.toggle('is-on', on);
      }
    }
    bar.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-ef-f]');
      if (!btn) return;
      if (btn.dataset.efF === 'all') pick = {};
      else {
        var f = btn.dataset.efF;
        pick[f] = pick[f] === btn.dataset.efV ? '' : btn.dataset.efV;
      }
      apply();
    });
    apply();
  })();
</script>
