---
/**
 * エンドフィールド wiki の記事ページ本体。
 *
 * NTE の EntityDetail（情報パネル＋サイドバー＋個人メモ…）とも
 * α の AlphaArticle（丸いカードの1カラム）とも別物として組む。
 *   - 見出しに「01 / SECTION」の番号ラベル
 *   - 要点は罫線で区切った定義リスト（箱を使わない）
 *   - 本文のあとに出典・更新日・前後の記事
 *
 * `updated`（本文を書き換えた日）と `checked`（内容は変えずに現行版でも正しいと
 * 確かめた日）を**分けて出す**。NTE 側と同じ誠実性ルール。
 */
import { Icon } from 'astro-icon/components';
import EndfieldLayout from '../../layouts/EndfieldLayout.astro';
import { withBase } from '../../lib/path';
import { sectionByCollection } from '../../lib/nav';
import { findLocalImage } from '../../lib/asset';
import { sizeAttrs } from '../../lib/img-size.mjs';

interface LinkRef {
  href: string;
  title: string;
}
interface Row {
  label: string;
  value: string;
}
interface Props {
  collection: string;
  /**
   * 記事の id（ファイル名）。渡すと、`images` を省いても
   * `public/images/official/endfield/<分類>/<id>.webp` を自動で探して出す。
   * 公式wikiから同梱したアイコンが、そのまま記事の絵になる。
   */
  entryId?: string;
  title: string;
  description?: string;
  /** 見出し（目次用）。depth 2 のみ使う */
  headings: { depth: number; slug: string; text: string }[];
  /** 冒頭に出す要点（レア度・職業・属性など） */
  rows?: Row[];
  badges?: string[];
  status?: 'verified' | 'draft';
  updated?: Date;
  checked?: Date;
  sources?: { label: string; url: string }[];
  prev?: LinkRef | null;
  next?: LinkRef | null;
  /**
   * 記事の絵（サイト内のパス）。公式サイトから同梱したもの。
   * 2枚目があるときは左右に並べる（「管理人」は姿が2つある）。
   */
  images?: string[];
  /** 絵の上に重ねるアイコン（職業・属性）のサイト内パス */
  icons?: string[];
  /**
   * ヒーローの下に出す帯（公式wiki の作りに合わせたもの）。
   * 職業・属性のアイコン、レア度の記号、ラベルと値の組、決めぜりふ。
   */
  hero?: {
    icons?: string[];
    rarity?: string;
    tags?: { label: string; value: string }[];
    quote?: string;
  };
}
const {
  collection,
  entryId,
  title,
  description,
  headings,
  rows = [],
  badges = [],
  status,
  updated,
  checked,
  sources = [],
  prev,
  next,
  images = [],
  icons = [],
  hero,
} = Astro.props;

/** レア度の「★6」から数字だけ取り出す（記号を6個並べるため） */
const stars = hero?.rarity ? Number(hero.rarity.replace(/[^0-9]/g, '')) : 0;

/* `images` が渡されていなければ、コレクション名と記事の id から自動で探す。
   置き場は一覧（EndfieldList）と同じ規則: `endfieldWeapons` → `official/endfield/weapons/`。 */
const autoDir = collection.replace(/^endfield/, '').toLowerCase();
const pics =
  images.length > 0
    ? images
    : entryId
      ? ([findLocalImage(`official/endfield/${autoDir}`, entryId)].filter(Boolean) as string[])
      : [];

const section = sectionByCollection(collection);
const toc = headings.filter((h) => h.depth === 2);
const fmt = (d: Date) => d.toLocaleDateString('ja-JP', { timeZone: 'Asia/Tokyo' });
---

<EndfieldLayout
  title={title}
  description={description}
  breadcrumbs={[
    ...(section ? [{ name: section.label, href: withBase(section.href) }] : []),
    { name: title, href: '#' },
  ]}
>
  {section && <p class="ef-eyebrow">{section.label}</p>}
  <h1 class="ef-title">{title}</h1>
  {description && <p class="ef-lead">{description}</p>}

  <div class="ef-crumbs" style="margin-bottom:18px;">
    {status === 'draft' && <span class="ef-badge is-draft">要確認（未検証）</span>}
    {status === 'verified' && <span class="ef-badge">出典で確認済み</span>}
    {badges.map((b) => <span class="ef-badge">{b}</span>)}
    {updated && <span>更新 {fmt(updated)}</span>}
    {/* 書き換えていないが現行版でも正しいと確かめた日。updated より新しいときだけ出す。 */}
    {checked && (!updated || checked > updated) && <span>確認 {fmt(checked)}</span>}
  </div>

  {
    status === 'draft' && (
      <p class="ef-note">
        <strong>この記事には未検証の情報が含まれます。</strong>
        出典で裏が取れていない数値・仕様には本文中に「要確認」と付けています。
        ゲーム内および公式のお知らせで最終確認してください。
      </p>
    )
  }

  {
    pics.length > 0 && (
      /* 公式サイトの絵。姿が2つあるものは並べて置く。
         左上に職業、その下に属性のアイコンを重ねる（公式のカードと同じ並び）。 */
      <div class="ef-figs" data-count={pics.length} data-dir={autoDir}>
        {pics.map((src, i) => (
          <figure class="ef-fig">
            {/* 1枚目は**開いてすぐ目に入る場所**にあるので、後回しにせず先に読む。
                ここを `lazy` にすると、画面に入っているのに読み始めが遅れ、
                絵が出るまで枠だけが残る。2枚目から（姿が2つあるもの）は後回しでよい。 */}
            <img
              src={src}
              alt={`${title}の姿`}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
              decoding="async"
              {...sizeAttrs(src)}
            />
            {icons.map((ic, k) => (
              <img class:list={['ef-fig-ic', { 'is-el': k === 1 }]} src={ic} alt="" width="26" height="26" />
            ))}
          </figure>
        ))}
      </div>
    )
  }

  {
    hero && (
      /* 公式wiki のヒーロー下のパネル。
         極小の英字ラベル → 名前 → 職業/属性＋レア度 → 3色ライン → ラベルと値 → せりふ */
      <div class="ef-hero-panel">
        <p class="ef-hero-kicker" aria-hidden="true">// ARKNIGHTS: ENDFIELD</p>
        <p class="ef-hero-name">[ {title} ]</p>
        <div class="ef-hero-meta">
          {(hero.icons ?? []).map((ic) => (
            <img class="ef-hero-ic" src={ic} alt="" width="26" height="26" />
          ))}
          {stars > 0 && (
            <span class="ef-stars" aria-label={`レア度 ${stars}`}>
              {Array.from({ length: stars }).map(() => (
                <i aria-hidden="true" />
              ))}
            </span>
          )}
        </div>
        <p class="ef-title-bar" aria-hidden="true" />
        {(hero.tags ?? []).length > 0 && (
          <div class="ef-hero-tags">
            {(hero.tags ?? []).map((t) => (
              <span class="ef-tagpair">
                <b>{t.label}</b>
                <span>{t.value}</span>
              </span>
            ))}
          </div>
        )}
        {hero.quote && <p class="ef-hero-quote">「{hero.quote}」</p>}
      </div>
    )
  }

  {
    rows.length > 0 && (
      /* 公式wikiの記事は、中身が**すべて「かたまり」の連なり**になっている
         （`widgets__Wrapper` の中に `WidgetWrapper` が縦に並ぶ）。
         その帯（灰色44px・16px太字・左に小さな飾り）に、
         公式**サイト**のバーコードの意匠を載せる。
         → 利用者の決定「公式サイト × 公式wiki」／実測は docs/UI-RESEARCH.md */
      <section class="ef-widget">
        <header class="ef-widget-head">
          <span class="ef-widget-tag" aria-hidden="true" />
          <h2 class="ef-widget-title">基本情報</h2>
          <span class="ef-barcode-label" aria-hidden="true">Details</span>
          <span class="ef-barcode" aria-hidden="true" />
        </header>
        <div class="ef-widget-body">
          <div class="ef-list ef-defs">
            {rows.map((r) => (
              <div class="ef-row" style="grid-template-columns:auto 1fr;">
                <span class="ef-row-meta">{r.label}</span>
                <span class="ef-row-body">{r.value}</span>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    toc.length > 1 && (
      <details class="ef-note" style="border-left-color:var(--ef-line);">
        <summary style="cursor:pointer;font-weight:700;">目次</summary>
        <ul style="margin:10px 0 0;padding-left:1.2em;">
          {toc.map((h) => (
            <li>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </details>
    )
  }

  <div class="ef-prose">
    <slot />
  </div>

  {
    sources.length > 0 && (
      <div class="ef-block">
        <h2>出典</h2>
        <ul>
          {sources.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener noreferrer">
                {s.label}
                <Icon name="lucide:external-link" style="width:13px;height:13px;margin-left:4px;" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {
    (prev || next) && (
      <div class="ef-block">
        <h2>この項目のほかの記事</h2>
        <div class="ef-list">
          {prev && (
            <a class="ef-row" href={prev.href} style="grid-template-columns:20px 1fr;">
              <Icon name="lucide:chevron-right" style="transform:rotate(180deg);" />
              <span class="ef-row-body">
                <span class="ef-row-name">{prev.title}</span>
              </span>
            </a>
          )}
          {next && (
            <a class="ef-row" href={next.href} style="grid-template-columns:20px 1fr;">
              <Icon name="lucide:chevron-right" />
              <span class="ef-row-body">
                <span class="ef-row-name">{next.title}</span>
              </span>
            </a>
          )}
        </div>
      </div>
    )
  }
</EndfieldLayout>
