---
/**
 * αテストwiki の記事ページ本体。
 *
 * NTE 側の EntityDetail（情報パネル＋サイドバー＋個人メモ…）とは別物で、
 * 「読む」ことに寄せた1カラム構成にしている。
 *   - 冒頭に要点（説明・分類バッジ）
 *   - 見出しが2つ以上あるときだけ折りたたみ目次を出す
 *   - 本文のあとに出典・更新日・前後の記事
 */
import { Icon } from 'astro-icon/components';
import AlphaLayout from '../../layouts/AlphaLayout.astro';
import { withBase } from '../../lib/path';
import { sectionByCollection } from '../../lib/nav';

interface LinkRef {
  href: string;
  title: string;
}
interface Props {
  collection: string;
  title: string;
  description?: string;
  /** 見出し（目次用）。depth 2 のみ使う */
  headings: { depth: number; slug: string; text: string }[];
  badges?: string[];
  status?: 'verified' | 'draft';
  updated?: Date;
  sources?: { label: string; url: string }[];
  prev?: LinkRef | null;
  next?: LinkRef | null;
  /** サンプルwikiである旨の注記を出すか */
  sample?: boolean;
}
const {
  collection,
  title,
  description,
  headings,
  badges = [],
  status,
  updated,
  sources = [],
  prev,
  next,
  sample = true,
} = Astro.props;

const section = sectionByCollection(collection);
const toc = headings.filter((h) => h.depth === 2);
---

<AlphaLayout
  title={title}
  description={description}
  breadcrumbs={[
    ...(section ? [{ name: section.label, href: withBase(section.href) }] : []),
    { name: title, href: '#' },
  ]}
>
  <article>
    <header>
      {section && <p class="a-eyebrow">{section.label}</p>}
      <h1 class="a-h1">{title}</h1>
      {description && <p class="a-lead">{description}</p>}

      {
        (badges.length > 0 || status === 'draft') && (
          <div class="a-badges">
            {badges.map((b) => (
              <span class="a-badge">{b}</span>
            ))}
            {status === 'draft' && <span class="a-badge a-badge-warn">要確認</span>}
          </div>
        )
      }

      <div class="a-meta">
        {updated && (
          <span>更新: {updated.toLocaleDateString('ja-JP', { timeZone: 'Asia/Tokyo' })}</span>
        )}
      </div>
    </header>

    {
      sample && (
        <div class="a-note">
          <Icon name="lucide:flask-conical" />
          <div>
            <strong>サンプル記事です</strong>
            この wiki の内容はマルチwiki機能を検証するためのダミーで、実在のゲームの攻略情報では
            ありません（→ <a href={withBase('/alpha/guides/about/')}>このwikiについて</a>）。
          </div>
        </div>
      )
    }

    {
      toc.length > 1 && (
        <details class="a-toc">
          <summary>目次（{toc.length}）</summary>
          <ol>
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </details>
      )
    }

    <div class="a-prose">
      <slot />
    </div>

    {
      sources.length > 0 && (
        <section class="a-sources">
          <h2>出典</h2>
          <ul>
            {sources.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener noreferrer">
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <nav class="a-pager" aria-label="前後の記事">
      {
        prev ? (
          <a class="a-card" href={prev.href}>
            <small>← 前の記事</small>
            <span class="a-card-title">{prev.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a class="a-card a-next" href={next.href}>
            <small>次の記事 →</small>
            <span class="a-card-title">{next.title}</span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
</AlphaLayout>
